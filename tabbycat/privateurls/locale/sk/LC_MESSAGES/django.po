msgstr "Nepodarilo sa prihlásiť na odber push notifikácií:"

#: privateurls/templates/private_url_landing.html:208
msgid "Server returned"
msgstr "Server vrátil"

#: privateurls/templates/private_url_landing.html:209
msgid "Successfully subscribed to push notifications!"
msgstr "Odber push notifikácií bol úspešne zapnutý!"

#: privateurls/templates/private_url_landing.html:210
