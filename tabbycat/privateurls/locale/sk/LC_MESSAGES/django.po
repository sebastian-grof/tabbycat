#: privateurls/templates/private_url_landing.html:31
#, python-format
msgid "Thank you for participating in %(tournament)s!"
msgstr "Ďakujeme za účasť na turnaji %(tournament)s!"

#: privateurls/templates/private_url_landing.html:37
msgid "The tournament is over. You can see the final results here:"
msgstr "Turnaj sa skončil. Konečné výsledky si môžete pozrieť tu:"

#: privateurls/templates/private_url_landing.html:39
msgid "The tournament is over. The final results will be available here once they are published."
msgstr "Turnaj sa skončil. Konečné výsledky tu nájdete hneď, ako budú zverejnené."

#: privateurls/templates/private_url_landing.html:46
