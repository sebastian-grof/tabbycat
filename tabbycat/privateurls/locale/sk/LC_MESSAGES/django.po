msgstr "Všem dosažitelným účastníkům již byly rozeslány jejich soukromé URL."

#: privateurls/templates/private_urls_nav.html:24
msgid "Email URLs"
msgstr "Poslať URL e-mailom"

#: privateurls/templates/private_urls_nav.html:31
