#, python-format
msgid "The already-existing private URL for %(nexisting_people)d person was left intact."
msgid_plural "The already-existing private URLs for %(nexisting_people)d people were left intact."
msgstr[0] "Již existující soukromá URL pro %(nexisting_people)d osobu byla ponechána nedotčená."
msgstr[1] "Již existující soukromé URL pro %(nexisting_people)d osoby byly ponechány nedotčené."
msgstr[2] "Již existující soukromé URL pro %(nexisting_people)d osob byly ponechány nedotčené."
msgstr[3] "Již existující soukromé URL pro %(nexisting_people)d osob byly ponechány nedotčené."

