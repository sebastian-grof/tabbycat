msgstr "Vášmu tímu momentálne nechýbajú žiadne feedbacky."

#: privateurls/templates/private_url_landing.html:203
msgid "Push notification permission denied"
msgstr "Povolenie push notifikácií bolo zamietnuté"

#: privateurls/templates/private_url_landing.html:204
msgid "Push notifications are blocked. Please enable them in your browser settings."
msgstr "Push notifikácie sú zablokované. Povoľ ich, prosím, v nastaveniach prehliadača."

#: privateurls/templates/private_url_landing.html:205
msgid "Push notifications are not supported in this browser."
msgstr "Tento prehliadač nepodporuje push notifikácie."

#: privateurls/templates/private_url_landing.html:206
msgid "Permission for notifications was denied"
msgstr "Povolenie notifikácií bolo zamietnuté"

#: privateurls/templates/private_url_landing.html:207
