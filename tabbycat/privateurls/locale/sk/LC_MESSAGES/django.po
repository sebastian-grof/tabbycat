#: privateurls/apps.py
msgid "Private URL Management"
msgstr "Správa súkromných URL"

#: privateurls/templates/private_url_landing.html
msgid "Private URL"
msgstr "Súkromná URL"

#: privateurls/templates/private_url_landing.html
#, python-format
msgid "for %(name)s"
msgstr "pre %(name)s"

#: privateurls/templates/private_url_landing.html
#, python-format
msgid "(%(team)s)"
msgstr "(%(team)s)"

#: privateurls/templates/private_url_landing.html
#, python-format
msgid "Your team has an incomplete number of speakers. Please share the registration link with your partner(s): <a href=\"%(link)s\">%(link)s</a>"
msgstr "Váš tím nemá kompletný počet rečníkov. Prosím, pošlite odkaz na registráciu svojim partnerom: <a href=\"%(link)s\">%(link)s</a>"

#: privateurls/templates/private_url_landing.html
#, python-format
msgid "The URL of this page is personalised to you, %(name)s. <strong>Do not share it with anyone;</strong> anyone who knows this URL can submit results and/or feedback for your debates. You may bookmark this page and return here after each debate for the available actions."
msgstr "Táto stránka je vytvorená pre vás, %(name)s. <strong>Nezdieľajte ju s nikým;</strong> každý, kto pozná túto URL, môže odosielať výsledky a/alebo spätnú väzbu k vašim debatám. Túto stránku si môžete pridať do záložiek a vrátiť sa sem po každej debate, kde nájdete dostupné možnosti."

#: privateurls/templates/private_url_landing.html
#, python-format
msgid "Revoke check-in from %(check_time)s"
msgstr "Zrušiť príchod z %(check_time)s"

#: privateurls/templates/private_url_landing.html
msgid "Check in"
msgstr "Potvrdiť príchod"

#. Translators: Include the full-stop; English doesn't because "a.m." already has a full stop.
#: privateurls/templates/private_url_landing.html
#, python-format
msgid "You have been checked in at %(check_time)s"
msgstr "Tvoj príchod bol potvrdený o %(check_time)s"

#: privateurls/templates/private_url_landing.html
msgid "You are not currently checked in."
msgstr "Momentálne nemáš potvrdený príchod."

#: privateurls/templates/private_url_landing.html
msgid "Show barcode for check-in"
msgstr "Zobraziť čiarový kód pre check-in"

#: privateurls/templates/private_url_landing.html
#, python-format
msgid "Submit Ballot for %(round)s"
msgstr "Odovzdať ballot pre %(round)s"

#: privateurls/templates/private_url_landing.html
msgid "Submit Feedback"
msgstr "Odoslať spätnú väzbu"

#: privateurls/templates/private_url_landing.html
#, python-format
msgid "Registration (%(name)s)"
msgstr "Registrácia (%(name)s)"

#: privateurls/templates/private_urls.html privateurls/views.py
msgid "Private URLs"
msgstr "Súkromné URL"

#: privateurls/templates/private_urls.html
msgid "The private URLs for ballot and/or feedback submission from participants are given below."
msgstr "Nižšie sú uvedené súkromné URL adresy pre odosielanie ballotov a/alebo spätnej väzby od účastníkov."

#: privateurls/templates/private_urls.html
msgid "Private URLs are used to allow participants to submit ballots and/or feedback online. You should use them if you have a means of distributing crazy-looking URLs to participants, and are too worried about fraud to use a publicly accessible page where <em>anyone</em> can enter <em>any</em> submission. The URLs will look something like this:"
msgstr "Súkromné URL adresy slúžia na to, aby účastníci mohli odosielať balloty a/alebo spätnú väzbu online. Mali by ste ich používať, ak máte možnosť distribuovať účastníkom URL adresy, ktoré vyzerajú podozrivo, a máte príliš veľké obavy z podvodov na to, aby ste použili verejne prístupnú stránku, kde <em>ktokoľvek</em> môže zadať <em>akýkoľvek</em> príspevok. URL adresy budú vyzerať približne takto:"

#: privateurls/templates/private_urls.html
msgid "Anyone with the URL can access the relevant data entry page. The idea is that it's hard to guess another key (the random-looking string), so you should make each URL accessible only to the participant in question. <a href=\"https://tabbycat.readthedocs.io/en/latest/features/data-entry.html#private-urls\"> Read more about private URLs.</a>"
msgstr "K stránke na zadávanie údajov má prístup každý, kto pozná príslušnú URL adresu. Myšlienka spočíva v tom, že je ťažké uhádnuť kľúč URL adresy (náhodne vyzerajúci reťazec), preto by ste mali zabezpečiť, aby každá URL adresa bola prístupná len príslušnému účastníkovi. <a href=\"https://tabbycat.readthedocs.io/en/latest/features/data-entry.html#private-urls\"> Prečítajte si viac o súkromných URL adresách.</a>"

#: privateurls/templates/private_urls.html
#, python-format
msgid "Neither <strong>participant ballot submissions</strong>, <strong>participant feedback submissions</strong>, nor <strong>participant self-checkins</strong> are configured to be from private URLs. Any generated URLs will not be useful unless you configure those settings accordingly on the <a href=\"%(data_entry_options_url)s\">tournament configuration page</a>."
msgstr "Ani <strong>odovzdané balloty účastníkov</strong>, <strong>spätná väzba od účastníkov</strong>, ani <strong>samostatné príchody účastníkov</strong> nie sú nastavené tak, aby využívali súkromné URL adries. Žiadne vygenerované URL adresy nebudú funkčné, pokiaľ tieto nastavenia zodpovedajúcim spôsobom nenastavíte na <a href=\"%(data_entry_options_url)s\">konfiguračnej stránke turnaja</a>."

#: privateurls/templates/private_urls.html
msgid "There are no private URLs assigned."
msgstr "Nie sú priradené žiadne súkromné URL."

#: privateurls/templates/private_urls.html
msgid "Generate Private URLs"
msgstr "Vygenerovať súkromné URL"

#: privateurls/templates/private_urls_nav.html
msgid "View URLs"
msgstr "Zobraziť URL"

#: privateurls/templates/private_urls_nav.html
msgid "Print Teams' URLs"
msgstr "Tlačiť URL tímov"

#: privateurls/templates/private_urls_nav.html
msgid "Print Adjudicators' URLs"
msgstr "Tlačiť URL rozhodcov"

#: privateurls/templates/private_urls_nav.html
msgid "All reachable participants have already been sent their private URLs."
msgstr "Všem dosažitelným účastníkům již byly rozeslány jejich soukromé URL."

#: privateurls/templates/private_urls_nav.html
msgid "Email URLs"
msgstr "Poslať URL e-mailom"

#: privateurls/templates/private_urls_nav.html
msgid "This button only generates private URLs for participants who do not already have one."
msgstr "Toto tlačidlo generuje súkromné URL adresy len pre účastníkov, ktorí ešte žiadnu nemajú."

#: privateurls/templates/private_urls_nav.html
msgid "Generate URLs"
msgstr "Vygenerovať URL"

#: privateurls/templates/private_urls_nav.html
msgid "All participants already have private URLs."
msgstr "Všetci účastníci uź majú súkromnú URL."

#: privateurls/views.py
msgid "no URL"
msgstr "žiadna URL"

#: privateurls/views.py
msgid "URL"
msgstr "URL"

