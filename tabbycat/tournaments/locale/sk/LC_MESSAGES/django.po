#: tournaments/apps.py
msgid "Tournaments"
msgstr "Turnaje"

#: tournaments/forms.py
msgid "Number of preliminary rounds"
msgstr "Počet základných kôl"

#: tournaments/forms.py
msgid "Number of teams in the open break"
msgstr "Počet tímov v open breaku"

#: tournaments/forms.py
msgid "Leave blank if there are no break rounds."
msgstr "Nechaj prázdne, ak nebudú žiadne breakové kolá."

#: tournaments/forms.py
msgid "Did you agree with their decision?"
msgstr "Súhlasil/a si s ich rozhodnutím?"

#: tournaments/forms.py
msgid "Agree?"
msgstr "Súhlas?"

#: tournaments/forms.py
msgid "Comments"
msgstr "Komentáre"

#. Translators: This is the name given to the 'Open Break'.
#: tournaments/forms.py
msgid "Open"
msgstr "Open"

#: tournaments/forms.py
msgid "Format Configuration"
msgstr "Nastavenie formátu"

#: tournaments/forms.py
msgid "Apply a standard set of settings to match a common debate format. These can be changed afterwards and should be checked for your needs."
msgstr "Použi štandardnú sadu nastavení pre bežný debatný formát. Tieto nastavenia sa dajú neskôr zmeniť a treba ich skontrolovať podľa potrieb turnaja."

#: tournaments/forms.py
msgid "Public Configuration"
msgstr "Verejné nastavenia"

#: tournaments/forms.py
msgid "Show non-sensitive information on the public-facing side of this site, like draws (once released) and the motions of previous rounds"
msgstr "Zobrazovať necitlivé informácie na verejnej časti stránky, napríklad pairingy po zverejnení a tézy z predchádzajúcich kôl"

#: tournaments/forms.py
msgid "Participant Data Entry"
msgstr "Zadávanie údajov účastníkmi"

#: tournaments/forms.py
msgid "Whether participants can submit ballots and feedback themselves, and how they do so"
msgstr "Či môžu účastníci sami odosielať balloty a spätnú väzbu, a akým spôsobom"

#: tournaments/forms.py
msgid "<strong>Tabulation:</strong> [list tabulation staff here]<br /><strong>Equity:</strong> [list equity members here]<br /><strong>Organisation:</strong> [list organising committee members here]<br /><strong>Adjudication:</strong> [list chief adjudicators here]"
msgstr "<strong>Tab:</strong> [sem uveď tab tím]<br /><strong>Equity:</strong> [sem uveď equity tím]<br /><strong>Organizácia:</strong> [sem uveď organizačný tím]<br /><strong>Adjudication:</strong> [sem uveď chief adjudicators]"

#: tournaments/forms.py
msgid "Current preliminary round"
msgstr "Aktuálne základné kolo"

#: tournaments/forms.py
msgid "All preliminary rounds have been completed"
msgstr "Všetky základné kolá boli dokončené"

#: tournaments/forms.py
#, python-format
msgid "Current elimination round in <strong>%(category)s</strong> <em>(only if all preliminary rounds have been completed)</em>"
msgstr "Aktuálne vyraďovacie kolo v kategórii <strong>%(category)s</strong> <em>(iba ak boli dokončené všetky základné kolá)</em>"

#: tournaments/forms.py
#, python-format
msgid "All elimination rounds in %(category)s have been completed"
msgstr "Všetky vyraďovacie kolá v kategórii %(category)s boli dokončené"

#: tournaments/forms.py
msgid "If the current round is a preliminary round, this field must be blank."
msgstr "Ak je aktuálne kolo základné kolo, toto pole musí zostať prázdne."

#: tournaments/forms.py
msgid "If all preliminary rounds have been completed, this field is required."
msgstr "Ak boli dokončené všetky základné kolá, toto pole je povinné."

#: tournaments/forms.py
#, python-format
msgid "%(name)s (%(abbreviation)s)"
msgstr "%(name)s (%(abbreviation)s)"

#: tournaments/mixins.py
#, python-format
msgid "You've been redirected to this page because tournament %(tournament)s has no rounds. Please create some before returning to the admin site."
msgstr "Bol/a si presmerovaný/á na túto stránku, pretože turnaj %(tournament)s nemá žiadne kolá. Pred návratom do administrácie nejaké kolá vytvor."

#: tournaments/mixins.py
#, python-format
msgid "There's a problem with the data for the tournament %(tournament)s. Please contact a tab director and ask them to investigate."
msgstr "V dátach turnaja %(tournament)s je problém. Kontaktuj tab directora a požiadaj ho, aby to skontroloval."

#: tournaments/mixins.py
msgid "You've been redirected to this page because of a problem with how teams are assigned to sides in a debate."
msgstr "Bol/a si presmerovaný/á na túto stránku pre problém s tým, ako sú tímom v debate pridelené strany."

#: tournaments/mixins.py
msgid "There's a problem with how teams are assigned to sides in a debate. The tab director will need to resolve this issue."
msgstr "Je tu problém s tým, ako sú tímom v debate pridelené strany. Tento problém musí vyriešiť tab director."

#: tournaments/mixins.py tournaments/templates/round_complete_check.html
#, python-format
msgid "for %(round)s"
msgstr "pre %(round)s"

#: tournaments/mixins.py
msgid "Return to Draw"
msgstr "Späť na pairing"

#: tournaments/models.py
msgid "You can't use this as a tournament slug, because it's reserved for a Tabbycat system URL. Please try another one."
msgstr "Toto nemôžeš použiť ako slug turnaja, pretože je vyhradený pre systémovú URL Tabbycatu. Skús iný slug."

#: tournaments/models.py
msgid "name"
msgstr "názov"

#: tournaments/models.py
msgid "The full name, e.g. \"Australasian Intervarsity Debating Championships 2016\""
msgstr "Celý názov, napr. „Australasian Intervarsity Debating Championships 2016“"

#: tournaments/models.py
msgid "short name"
msgstr "krátky názov"

#: tournaments/models.py
msgid "The name used in the menu, e.g. \"Australs 2016\""
msgstr "Názov používaný v menu, napr. „Australs 2016“"

#: tournaments/models.py
msgid "sequence number"
msgstr "poradové číslo"

#: tournaments/models.py
msgid "A number that determines the relative order in which tournaments are displayed on the homepage."
msgstr "Číslo, ktoré určuje relatívne poradie zobrazovania turnajov na domovskej stránke."

#: tournaments/models.py
msgid "slug"
msgstr "slug"

#: tournaments/models.py
msgid "The sub-URL of the tournament, cannot have spaces, e.g. \"australs2016\""
msgstr "Časť URL turnaja; nesmie obsahovať medzery, napr. „australs2016“"

#: tournaments/models.py
msgid "active"
msgstr "aktívny"

#: tournaments/models.py
msgid "tournament"
msgstr "turnaj"

#: tournaments/models.py
msgid "tournaments"
msgstr "turnaje"

#: tournaments/models.py
msgid "Random"
msgstr "Náhodný"

#: tournaments/models.py
msgid "Manual"
msgstr "Manuálny"

#: tournaments/models.py
msgid "Round-robin"
msgstr "Round-robin"

#: tournaments/models.py
msgid "Power-paired"
msgstr "Power-paired"

#: tournaments/models.py
msgid "Elimination"
msgstr "Vyraďovacie"

#: tournaments/models.py
msgid "Seeded"
msgstr "Seedované"

#: tournaments/models.py
msgid "Preliminary"
msgstr "Základné"

#: tournaments/models.py
msgid "None"
msgstr "Žiadne"

#: tournaments/models.py
msgid "Draft"
msgstr "Koncept"

#: tournaments/models.py
msgid "Confirmed"
msgstr "Potvrdené"

#: tournaments/models.py
msgid "Released"
msgstr "Zverejnené"

#: tournaments/models.py
msgid "A number that determines the order of the round, should count consecutively from 1 for the first round"
msgstr "Číslo, ktoré určuje poradie kola; malo by ísť za sebou od 1 pre prvé kolo"

#: tournaments/models.py
msgid "completed"
msgstr "dokončené"

#: tournaments/models.py
msgid "True if the round is over, which normally means all results have been entered and confirmed"
msgstr "Platí, ak sa kolo skončilo; zvyčajne to znamená, že všetky výsledky boli zadané a potvrdené"

#: tournaments/models.py
msgid "e.g. \"Round 1\""
msgstr "napr. „Kolo 1“"

#: tournaments/models.py
msgid "abbreviation"
msgstr "skratka"

#: tournaments/models.py
msgid "e.g. \"R1\""
msgstr "napr. „R1“"

#: tournaments/models.py
msgid "stage"
msgstr "fáza"

#: tournaments/models.py
msgid "Preliminary = inrounds, elimination = outrounds"
msgstr "Základné = inrounds, vyraďovacie = outrounds"

#: tournaments/models.py
msgid "draw type"
msgstr "typ pairingu"

#: tournaments/models.py
msgid "Which draw method to use"
msgstr "Ktorú metódu pairingu použiť"

#: tournaments/models.py
msgid "break category"
msgstr "breaková kategória"

#: tournaments/models.py
msgid "If elimination round, which break category"
msgstr "Ak ide o vyraďovacie kolo, ktorá breaková kategória"

#: tournaments/models.py
msgid "draw status"
msgstr "stav pairingu"

#: tournaments/models.py
msgid "The status of this round's draw"
msgstr "Stav pairingu tohto kola"

#: tournaments/models.py
msgid "feedback weight"
msgstr "váha spätnej väzby"

#: tournaments/models.py
#, no-python-format
msgid "The extent to which each adjudicator's overall score depends on feedback vs their base score. At 0, it is 100% drawn from their base score, at 1 it is 100% drawn from feedback."
msgstr "Miera, do akej celkové skóre rozhodcu/rozhodkyne závisí od spätnej väzby oproti základnému skóre. Pri hodnote 0 vychádza na 100 % zo základného skóre, pri hodnote 1 na 100 % zo spätnej väzby."

#. Translators: A silent round is a round for which results are not disclosed once the round is over.
#: tournaments/models.py
msgid "silent"
msgstr "tiché"

#: tournaments/models.py
msgid "If marked silent, information about this round (such as its results) will not be shown publicly."
msgstr "Ak je kolo označené ako tiché, informácie o tomto kole, napríklad jeho výsledky, sa nezobrazia verejne."

#: tournaments/models.py
msgid "motions released"
msgstr "tézy zverejnené"

#: tournaments/models.py
msgid "Whether motions will appear on the public website, assuming that feature is turned on"
msgstr "Či sa tézy zobrazia na verejnej stránke, ak je táto funkcia zapnutá"

#: tournaments/models.py
msgid "starts at"
msgstr "začína o"

#: tournaments/models.py
msgid "weight"
msgstr "váha"

#: tournaments/models.py
msgid "A factor for the points received in the round. For example, if 2, all points are doubled."
msgstr "Koeficient bodov získaných v kole. Napríklad pri hodnote 2 sa všetky body zdvojnásobia."

#: tournaments/models.py
msgid "round"
msgstr "kolo"

#: tournaments/models.py
msgid "rounds"
msgstr "kolá"

#: tournaments/models.py
msgid "The \"Elimination\" draw type is only for elimination rounds, where it is mandatory."
msgstr "Typ pairingu „Vyraďovacie“ je určený iba pre vyraďovacie kolá, kde je povinný."

#: tournaments/models.py
msgid "An elimination round must have a break category and preliminary round must not."
msgstr "Vyraďovacie kolo musí mať breakovú kategóriu a základné kolo ju mať nesmie."

#: tournaments/models.py
msgid "Break category must be for the same tournament."
msgstr "Breaková kategória musí patriť k rovnakému turnaju."

