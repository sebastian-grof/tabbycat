msgstr[0] "Stále zostáva %(num_unconfirmed)s nepotvrdený ballot. <strong>Nemal/a by si</strong> pokračovať do ďalšieho kola, kým nie sú potvrdené všetky balloty."
msgstr[1] "Stále zostávajú %(num_unconfirmed)s nepotvrdené balloty. <strong>Nemal/a by si</strong> pokračovať do ďalšieho kola, kým nie sú potvrdené všetky balloty."
msgstr[2] "Stále zostávajú %(num_unconfirmed)s nepotvrdené balloty. <strong>Nemal/a by si</strong> pokračovať do ďalšieho kola, kým nie sú potvrdené všetky balloty."
msgstr[3] "Stále zostáva %(num_unconfirmed)s nepotvrdených ballotov. <strong>Nemal/a by si</strong> pokračovať do ďalšieho kola, kým nie sú potvrdené všetky balloty."

#: tournaments/templates/round_complete_check.html
msgid "<p>This round is a silent round.</p> <p> Even though public view of results is enabled, results for <em>this</em> round will still be hidden from public view after completing this round. <p> <p> You can change whether this round is silent using the button above. </p>"
msgstr "<p>Toto kolo je tiché.</p> <p>Aj keď je verejné zobrazovanie výsledkov zapnuté, výsledky <em>tohto</em> kola zostanú po jeho dokončení skryté pred verejnosťou. <p> <p>To, či je toto kolo tiché, môžeš zmeniť tlačidlom vyššie. </p>"

#: tournaments/templates/round_complete_check.html
#, python-format
msgid "<p><strong> Results for %(round)s will be published online once you mark this round as complete! </strong></p> <p> This round is <em>not</em> a silent round, and public view of results is enabled. </p> <p> If you want to keep the results for just this round hidden, you can mark this round as silent using the button above. </p> <p> If you want to disable the public view of results, you can do so in the <a href=\"%(public_features_url)s\">tournament configuration</a>. </p>"
msgstr "<p><strong>Výsledky pre %(round)s sa po označení tohto kola ako dokončeného zverejnia online!</strong></p> <p>Toto kolo <em>nie je</em> tiché a verejné zobrazovanie výsledkov je zapnuté.</p> <p>Ak chceš ponechať skryté iba výsledky tohto kola, môžeš ho označiť ako tiché tlačidlom vyššie.</p> <p>Ak chceš vypnúť verejné zobrazovanie výsledkov, môžeš to spraviť v <a href=\"%(public_features_url)s\">nastavení turnaja</a>.</p>"

