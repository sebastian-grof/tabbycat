#: tournaments/views.py:310
#, python-format
msgid "%(round)s has been marked as silent."
msgstr "%(round)s bolo označené ako tiché."

#: tournaments/views.py:312
#, python-format
msgid "%(round)s has been unmarked as silent."
msgstr "Pri %(round)s bolo zrušené označenie ako tiché."

#: tournaments/views.py:330
#, python-format
msgid "%(round)s has been marked as completed. All rounds are now completed, so you're done with the tournament! Congratulations!"
msgstr "%(round)s bolo označené ako dokončené. Všetky kolá sú teraz dokončené, takže turnaj je hotový. Gratulujem!"

#: tournaments/views.py:336
#, python-format
msgid "%(round)s has been marked as completed. That's the last round in that sequence! Going back to the first round that hasn't been marked as completed."
msgstr "%(round)s bolo označené ako dokončené. To bolo posledné kolo v tejto sekvencii. Vraciam sa na prvé kolo, ktoré ešte nebolo označené ako dokončené."

#: tournaments/views.py:349
#, python-format
msgid "%(round)s has been marked as completed. You've made it to the end of the preliminary rounds! Congratulations! The next step is to generate the break."
msgstr "%(round)s bolo označené ako dokončené. Dostali sme sa na koniec základných kôl. Gratulujem! Ďalším krokom je vygenerovať break."

#: tournaments/views.py:355
#, python-format
msgid "%(round)s has been marked as completed. That was the last preliminary round, but one or more preliminary rounds are still not completed. Going back to the first incomplete preliminary round."
msgstr "%(round)s bolo označené ako dokončené. Bolo to posledné základné kolo, ale jedno alebo viac základných kôl ešte nie je dokončených. Vraciam sa na prvé nedokončené základné kolo."

#: tournaments/views.py:363
#, python-format
msgid "%(this_round)s has been marked as completed. Moving on to %(next_round)s! Woohoo! Keep it up!"
msgstr "%(this_round)s bolo označené ako dokončené. Pokračujeme na %(next_round)s! Super, ideš dobre!"

