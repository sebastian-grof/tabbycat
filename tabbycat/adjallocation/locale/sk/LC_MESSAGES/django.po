#: adjallocation/allocators/base.py
msgid "There are no available adjudicators. Ensure there are adjudicators who have been marked as available for this round before auto-allocating."
msgstr "Nie sú dostupní žiadni rozhodcovia/rozhodkyne. Pred automatickou alokáciou sa uisti, že niektorí rozhodcovia/rozhodkyne sú v tomto kole označení ako dostupní."

#: adjallocation/allocators/hungarian.py
#, python-format
msgid "%(count)s score is larger than the maximum permitted adjudicator score (%(score).1f)."
msgid_plural "%(count)s scores are larger than the maximum permitted adjudicator score (%(score).1f)."
msgstr[0] "%(count)s skóre je vyššie ako maximálne povolené skóre rozhodcu/rozhodkyne (%(score).1f)."
msgstr[1] "%(count)s skóre sú vyššie ako maximálne povolené skóre rozhodcu/rozhodkyne (%(score).1f)."
msgstr[2] "%(count)s skóre sú vyššie ako maximálne povolené skóre rozhodcu/rozhodkyne (%(score).1f)."

#: adjallocation/allocators/hungarian.py
#, python-format
msgid "%(count)s score is smaller than the minimum permitted adjudicator score (%(score).1f)."
msgid_plural "%(count)s scores are smaller than the minimum permitted adjudicator score (%(score).1f)."
msgstr[0] "%(count)s skóre je nižšie ako minimálne povolené skóre rozhodcu/rozhodkyne (%(score).1f)."
msgstr[1] "%(count)s skóre sú nižšie ako minimálne povolené skóre rozhodcu/rozhodkyne (%(score).1f)."
msgstr[2] "%(count)s skóre sú nižšie ako minimálne povolené skóre rozhodcu/rozhodkyne (%(score).1f)."

#: adjallocation/allocators/hungarian.py
msgid "There are no adjudicators eligible to be a chair or panellist. Try changing the \"Minimum feedback score required to be allocated as chair or panellist\" setting to something lower than at least some adjudicators' current scores, and try again."
msgstr "Žiaden z rozhodcov nespĺňa podmienky na to, aby bol chairom alebo panelistom. Skúste zmeniť nastavenie „Minimálne skóre spätnej väzby potrebné na pridelenie funkcie chaira alebo člena panelistu“ na hodnotu nižšiu, ako sú aktuálne skóre aspoň niektorých rozhodcov, a skúste to znova."

#: adjallocation/allocators/hungarian.py
msgid "There are no debates for this round. Maybe you haven't created a draw yet?"
msgstr "Nie sú žiadne debaty pre toto kolo. Možno si žiadne ešte nevytvoril?"

#: adjallocation/allocators/hungarian.py
#, python-format
msgid "There are %(debate_count)s debates but only %(adj_count)s voting adjudicators."
msgstr "Je tu %(debate_count)s debát, ale iba %(adj_count)s hlasujúcich rozhodcov/rozhodkýň."

#: adjallocation/allocators/hungarian.py
#, python-format
msgid "There are %(panel_debates)s panel debates but only %(panellists)s available panellists (less than %(needed)s)."
msgstr "Je tu %(panel_debates)s panelových debát, ale iba %(panellists)s dostupných panelistov/panelistiek (menej ako %(needed)s)."

#: adjallocation/allocators/hungarian.py
#, python-format
msgid "There are %(debates_count)s debates but only %(voting_count)s voting adjudicators."
msgstr "Je tu %(debates_count)s debát, ale iba %(voting_count)s hlasujúcich rozhodcov/rozhodkýň."

#: adjallocation/apps.py
msgid "Adjudicator Allocation"
msgstr "Alokácia rozhodcov/rozhodkýň"

#: adjallocation/consumers.py
msgid "Draw is already released, unrelease draw to redo auto-allocations."
msgstr "Pairing je už zverejnený, zruš zverejnenie pairingu, aby si prerobil auto-priradenie."

#: adjallocation/consumers.py
msgid "Draw is not confirmed, confirm draw to run auto-allocations."
msgstr "Pairing nie je potvrdený, potvrď pairing, aby ste mohli spustiť auto-priradenie."

#: adjallocation/consumers.py
msgid "There are no preformed panels available to allocate."
msgstr "Nie sú dostupné žiadne predpripravené panely na alokáciu."

#: adjallocation/consumers.py
msgid "Successfully auto-allocated preformed panels to debates."
msgstr "Úspešne automaticky pridelené predpripravené panely na debaty."

#: adjallocation/consumers.py
#, python-format
msgid "Successfully auto-allocated adjudicators to debates. However, there was a warning:"
msgid_plural "Successfully auto-allocated adjudicators to debates. However, there were %(count)d warnings:"
msgstr[0] "Úspešne automaticky pridelené rozhodcovia/rozhodkyne na debaty. avšak, there bolo upozornenie:"
msgstr[1] "Úspešne automaticky pridelené rozhodcovia/rozhodkyne na debaty. avšak, there boli %(count)d upozornenies:"
msgstr[2] "Úspešne automaticky pridelené rozhodcovia/rozhodkyne na debaty. avšak, there boli %(count)d upozornenies:"

#: adjallocation/consumers.py
msgid "Successfully auto-allocated adjudicators to debates."
msgstr "Úspešne automaticky pridelené rozhodcovia/rozhodkyne na debaty."

#: adjallocation/consumers.py
msgid "There aren't any panels to fill. Create panels first."
msgstr "Nie sú žiadne panely na doplnenie. Najprv vytvor panely."

#: adjallocation/consumers.py
#, python-format
msgid "Successfully auto-allocated adjudicators to preformed panels. However, there was a warning:"
msgid_plural "Successfully auto-allocated adjudicators to preformed panels. However, there were %(count)d warnings:"
msgstr[0] "Úspešne automaticky pridelené rozhodcovia/rozhodkyne na preformuláred panels. avšak, there bolo upozornenie:"
msgstr[1] "Úspešne automaticky pridelené rozhodcovia/rozhodkyne na preformuláred panels. avšak, there boli %(count)d upozornenies:"
msgstr[2] "Úspešne automaticky pridelené rozhodcovia/rozhodkyne na preformuláred panels. avšak, there boli %(count)d upozornenies:"

#: adjallocation/consumers.py
msgid "Successfully auto-allocated adjudicators to preformed panels."
msgstr "Úspešne automaticky pridelené rozhodcovia/rozhodkyne na predpripravené panely."

#: adjallocation/consumers.py
msgid "You have no break category set as 'is general' so debate importances can't be calculated."
msgstr "Žiadna breaková kategória nemá nastavené „je všeobecná“, preto sa nedá vypočítať dôležitosť debát."

#: adjallocation/consumers.py
msgid "Succesfully auto-prioritised debates."
msgstr "Úspešne auto-prioritised debaty."

#: adjallocation/consumers.py
msgid "You have no break category set as 'is general' so panel importances can't be calculated."
msgstr "Žiadna breaková kategória nemá nastavené „je všeobecná“, preto sa nedá vypočítať dôležitosť panelov."

#: adjallocation/consumers.py
msgid "Succesfully auto-prioritised preformed panels."
msgstr "Úspešne auto-prioritised predpripravené panely."

#: adjallocation/consumers.py
msgid "Since this is the first round, the preformed panels aren't annotated with brackets and liveness."
msgstr "Keďže ide o prvé kolo, predpripravené panely nemajú anotované koše ani liveness."

#: adjallocation/consumers.py
msgid "The previous round's draw doesn't exist, so preformed panels can't be annotated with brackets and liveness."
msgstr "Pairing z predchádzajúceho kola neexistuje, preto sa nemôžu predpripravené panely anotovať košmi, alebo liveliness."

#: adjallocation/consumers.py
msgid "Succesfully created new preformed panels for this round."
msgstr "Úspešne vytvorené nové predpripravené panely pre toto kolo."

