msgid "There are no preformed panels available to allocate."
msgstr "Nie sú dostupné žiadne predpripravené panely na alokáciu."

#: adjallocation/consumers.py:93
msgid "Successfully auto-allocated preformed panels to debates."
msgstr "Úspešne automaticky pridelené predpripravené panely na debaty."

#: adjallocation/consumers.py:119
#, python-format
