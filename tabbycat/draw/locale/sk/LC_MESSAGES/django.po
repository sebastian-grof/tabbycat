#: draw/views.py:728
msgid "The draw could not be created, because another user was also creating a draw."
msgstr "Pairing sa nepodarilo vytvoriť, pretože iný používateľ tiež práve vytvára pairing."

#: draw/views.py:736
msgid "Rooms were not auto-allocated because there are one or more adjudicator room constraints. You should run room allocations after allocating adjudicators."
msgstr "Miestnosti neboli automaticky priradené, pretože existujú jedno alebo viacero obmedzení miestností pre rozhodcov. Priradenie miestností by si mal/a spustiť po priradení rozhodcov."

#: draw/views.py:750
msgid "There is no draw."
msgstr "Neexistuje žiadny pairing."

#: draw/views.py:752
msgid "The draw had already been confirmed."
msgstr "Pairing už bol potvrdený."

#: draw/views.py:796
msgid "Overwrote preformed panels with current panels."
msgstr "Predpripravené panely boli prepísané aktuálnymi panelmi."

#: draw/views.py:799
msgid "Deleted the draw. You can now recreate it as normal."
msgstr "Pairing bol vymazaný. Teraz ho môžeš znovu vytvoriť štandardným spôsobom."

#: draw/views.py:814 draw/views.py:881
msgid "The draw has already been released."
msgstr "Pairing už bol zverejnený."

#: draw/views.py:816 draw/views.py:883
msgid "The draw must be confirmed before being released."
msgstr "Pairing musí byť potvrdený pred zverejnením."

#: draw/views.py:826
msgid "Released the draw."
msgstr "Pairing bol zverejnený."

#: draw/views.py:834
#, python-format
msgid "%(tournament)s - %(round)s"
msgstr "%(tournament)s – %(round)s"

#: draw/views.py:845
#, python-format
msgid "You are the %(type)s in %(venue)s, adjudicating %(matchup)s"
msgid_plural "You are a %(type)s in %(venue)s, adjudicating %(matchup)s"
msgstr[0] "Si %(type)s v %(venue)s, rozhoduješ %(matchup)s"
msgstr[1] "Si %(type)s v %(venue)s, rozhoduješ %(matchup)s"
msgstr[2] "Si %(type)s v %(venue)s, rozhoduješ %(matchup)s"
msgstr[3] "Si %(type)s v %(venue)s, rozhoduješ %(matchup)s"

#: draw/views.py:850 draw/views.py:865
msgid "Room TBA"
msgstr "Miestnosť bude oznámená"

#: draw/views.py:863
#, python-format
msgid "You are the %(type)s in %(venue)s, with %(matchup)s"
msgstr "Si %(type)s v %(venue)s, s %(matchup)s"

#: draw/views.py:890
msgid "Released the draw (teams only)."
msgstr "Pairing bol zverejnený (len tímy)."

#: draw/views.py:901
msgid "The draw had been unreleased."
msgstr "Zverejnenie pairingu bolo zrušené."

#: draw/views.py:907
msgid "Unreleased the draw."
msgstr "Zverejnenie pairingu bolo zrušené."

#: draw/views.py:921
#, python-format
msgid "Sorry, \"%(input)s\" isn't a valid time. It must be in 24-hour format, with a colon, for example: \"13:57\"."
msgstr "Ľutujem, \"%(input)s\" nie je platný čas. Musí byť v 24-hodinovom formáte s dvojbodkou, napríklad: \"13:57\"."

#: draw/views.py:940 draw/views.py:969
msgid "Side Pre-Allocations"
msgstr "Predpriradenia strán"

#: draw/views.py:1122
#, python-format
msgid "%(count)d active team is unassigned."
msgid_plural "%(count)d active teams are unassigned."
msgstr[0] "%(count)d aktívny tím je nepriradený."
msgstr[1] "%(count)d aktívne tímy sú nepriradené."
msgstr[2] "%(count)d aktívneho tímu je nepriradených."
msgstr[3] "%(count)d aktívnych tímov je nepriradených."

#: draw/views.py:1128
#, python-format
msgid "%(count)d saved allocation belongs to a team that is currently unavailable."
msgid_plural "%(count)d saved allocations belong to teams that are currently unavailable."
msgstr[0] "%(count)d uložené priradenie patrí tímu, ktorý je momentálne nedostupný."
msgstr[1] "%(count)d uložené priradenia patria tímom, ktoré sú momentálne nedostupné."
msgstr[2] "%(count)d uloženého priradenia patrí tímom, ktoré sú momentálne nedostupné."
msgstr[3] "%(count)d uložených priradení patrí tímom, ktoré sú momentálne nedostupné."

#: draw/views.py:1135
#, python-format
msgid "Current split is %(left)s %(left_count)d / %(right)s %(right_count)d, which doesn't match a valid split for the active teams in this round."
msgstr "Aktuálne rozdelenie je %(left)s %(left_count)d / %(right)s %(right_count)d, čo nezodpovedá platnému rozdeleniu pre aktívne tímy v tomto kole."

#: draw/views.py:1143
msgid "Pre-allocated draws work best when every active team is assigned and the saved side split is valid for the current field."
msgstr "Pairingy s predpriradením fungujú najlepšie, keď je každý aktívny tím priradený a uložené rozdelenie strán je platné pre aktuálne pole."

#: draw/views.py:1161
#, python-format
msgid "Random side allocations generated for %(round)s."
msgstr "Pre %(round)s boli vygenerované náhodné priradenia strán."

#: draw/views.py:1165
#, python-format
msgid "Side allocations for %(target)s were copied as the opposite of %(source)s."
msgstr "Priradenia strán pre %(target)s boli skopírované ako opak %(source)s."

#: draw/views.py:1171
#, python-format
msgid "Cleared saved side allocations for %(round)s. This round will pair first and assign sides afterwards."
msgstr "Uložené priradenia strán pre %(round)s boli vymazané. Toto kolo sa najprv spáruje a strany budú priradené potom."

#: draw/views.py:1191
#, python-format
msgid "Cleared the bye override for %(round)s. The tournament setting will be used."
msgstr "Manuálne určenie bye pre %(round)s bolo vymazané. Použije sa nastavenie turnaja."

#: draw/views.py:1193
#, python-format
msgid "Set %(team)s as the manual bye override for %(round)s."
msgstr "%(team)s bol nastavený ako manuálne určenie bye pre %(round)s."

#: draw/views.py:1210
#, python-format
msgid "Saved side allocations for %(round)s."
msgstr "Priradenia strán pre %(round)s boli uložené."

#: draw/views.py:1214
msgid "Unrecognized side allocation action."
msgstr "Nerozpoznaná akcia priradenia strán."

#: draw/views.py:1224
msgid "Edit Matchups"
msgstr "Upraviť zápasy"
