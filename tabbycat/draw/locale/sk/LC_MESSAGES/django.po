#: draw/generator/bpelimination.py:34 draw/generator/elimination.py:68
#, python-format
msgid "%d debates in the previous round don't have a result."
msgstr "%d debát z predchádzajúceho kola nemá výsledok."

#: draw/generator/bpelimination.py:36
#, python-format
msgid "%d debates in the previous round don't have exactly two teams advancing."
msgstr "%d debát z predchádzajúceho kola nemá presne dva postupujúce tímy."

#: draw/generator/bpelimination.py:69
#, python-format
msgid "The room ranks of the partial elimination round indicate that an odd number of teams (%(nbypassing)d) bypassed it."
msgstr "Poradie miestností v čiastočnom vyraďovacom kole naznačuje, že nepárny počet tímov (%(nbypassing)d) ho preskočil."

#: draw/generator/bpelimination.py:73
#, python-format
msgid "The room ranks of the partial elimination round indicate that %(nbypassing)d teams bypassed it, but %(nadvancing)d teams advanced from it."
msgstr "Poradie miestností v čiastočnom vyraďovacom kole naznačuje, že %(nbypassing)d tímov ho preskočilo, ale %(nadvancing)d tímov z neho postúpilo."

#: draw/generator/bpelimination.py:119
#, python-format
msgid "The number of debates (%d) in the last round is not a power of two."
msgstr "Počet debát (%d) v poslednom kole nie je mocninou dvoch."

#: draw/generator/bphungarian.py:171
#, python-format
msgid "The Rényi order can't be negative, and it's currently set to %(alpha)f."
msgstr "Rényiho rád nemôže byť záporný, momentálne je nastavený na %(alpha)f."

#: draw/generator/common.py:54
#, python-format
msgid "The number of teams presented for the draw was not a multiple of %(num)d."
msgstr "Počet tímov zaradených do pairingu nebol násobkom čísla %(num)d."

#: draw/generator/common.py:57
msgid "There were no teams for the draw."
msgstr "Pre pairing neboli žiadne tímy."

#: draw/generator/elimination.py:43
#, python-format
msgid "There are only %d teams breaking in this category; there need to be at least two to generate an elimination round draw."
msgstr "V tejto kategórii postupujú len %d tímy; na generovanie pairingu vyraďovacieho kola sú potrebné aspoň dva tímy."

#: draw/generator/elimination.py:75
#, python-format
msgid "The number of teams (%d) in this round is not a power of two."
msgstr "Počet tímov (%d) v tomto kole nie je mocninou dvoch."

#: draw/generator/graph.py:76
msgid "Couldn't find a complete matching for bye selection."
msgstr "Nepodarilo sa nájsť úplné párovanie pre výber bye."

#: draw/generator/graph.py:83 draw/generator/graph.py:167
#: draw/generator/powerpair.py:706 draw/generator/powerpair.py:748
#: draw/generator/powerpair.py:1299
msgid "Unmatched-team bye selection requires an odd number of teams."
msgstr "Výber bye nepárovaným tímom vyžaduje nepárny počet tímov."

#: draw/generator/graph.py:101 draw/generator/graph.py:195
msgid "Couldn't find a valid unmatched team for bye selection."
msgstr "Nepodarilo sa nájsť platný nepárovaný tím pre výber bye."

#: draw/generator/graph.py:146
#, python-format
msgid "Saved side allocations left %(aff)d affirmative teams but %(neg)d negative teams in the bracket after pullups."
msgstr "Uložené priradenia strán zanechali %(aff)d afirmatívnych tímov, ale %(neg)d negatívnych tímov v koši po pull-upoch."

#: draw/generator/graph.py:159
msgid "Couldn't find a complete side-constrained matching for bye selection."
msgstr "Nepodarilo sa nájsť úplné párovanie s obmedzením strán pre výber bye."

#: draw/generator/graph.py:209
#, python-format
msgid "Saved side allocations left an invalid bracket %(bracket)s after pullups: %(message)s"
msgstr "Uložené priradenia strán zanechali neplatný kôš %(bracket)s po pull-upoch: %(message)s"

#: draw/generator/powerpair.py:99
#, python-format
msgid "%(noninteger)d out of %(total)d teams have a noninteger first metric in the team standings. Intermediate brackets require the first team standings metric to be an integer (typically points or wins)."
msgstr "%(noninteger)d z %(total)d tímov má necelé číslo ako prvú metriku v poradí tímov. Medzikošové pairingy vyžadujú, aby prvá metrika poradia tímov bola celé číslo (zvyčajne body alebo výhry)."

#: draw/generator/powerpair.py:127 draw/generator/powerpair.py:283
#: draw/generator/powerpair.py:882 draw/generator/powerpair.py:887
msgid "This bye-selection method requires an odd number of teams."
msgstr "Táto metóda výberu bye vyžaduje nepárny počet tímov."

#: draw/generator/powerpair.py:144
msgid "This bye-selection method isn't supported with a custom pairing method."
msgstr "Táto metóda výberu bye nie je podporovaná s vlastnou metódou pairingu."

#: draw/generator/powerpair.py:171 draw/generator/powerpair.py:194
#: draw/generator/powerpair.py:220
#, python-format
msgid "This bye-selection method isn't supported with the pairing method '%(method)s'."
msgstr "Táto metóda výberu bye nie je podporovaná s metódou pairingu '%(method)s'."

#: draw/generator/powerpair.py:179 draw/generator/powerpair.py:278
#: draw/generator/powerpair.py:908
msgid "Couldn't determine an unmatched team in the final odd bracket."
msgstr "Nepodarilo sa určiť nepárovaný tím v záverečnom nepárnom koši."

#: draw/generator/powerpair.py:289 draw/generator/powerpair.py:711
#: draw/generator/powerpair.py:893 draw/generator/powerpair.py:1304
msgid "Couldn't determine a final odd bracket for bye selection."
msgstr "Nepodarilo sa určiť záverečný nepárny kôš pre výber bye."

#: draw/generator/powerpair.py:306 draw/generator/powerpair.py:939
#, python-format
msgid "This bye-selection method isn't supported with the odd-bracket setting '%(setting)s'."
msgstr "Táto metóda výberu bye nie je podporovaná s nastavením nepárneho koša '%(setting)s'."

#: draw/generator/powerpair.py:578
msgid "Draw strength pullups require 'Minimum cost matching (including pullups)' as the conflict avoidance method"
msgstr "Pull-upy na základe sily pairingu vyžadujú 'Párovanie s minimálnymi nákladmi (vrátane pull-upov)' ako metódu vyhýbania sa konfliktom"

#: draw/generator/powerpair.py:733 draw/generator/powerpair.py:750
msgid "Intermediate-type pullups require 'One-up-one-down' as the conflict avoidance method"
msgstr "Pull-upy stredného typu vyžadujú 'Jeden nahor-jeden nadol' ako metódu vyhýbania sa konfliktom"

#: draw/generator/powerpair.py:978 draw/generator/powerpair.py:1015
#: draw/generator/powerpair.py:1066
msgid "Saved side allocations left more than one odd bracket after pullups."
msgstr "Uložené priradenia strán zanechali viac ako jeden nepárny kôš po pull-upoch."

#: draw/generator/random.py:139
#, python-format
msgid "There were %(aff_count)d affirmative teams but %(neg_count)d negative teams."
msgstr "Bolo %(aff_count)d afirmatívnych tímov, ale %(neg_count)d negatívnych tímov."

#: draw/generator/random.py:142
msgid "One or more teams had an allocated side that wasn't affirmative or negative."
msgstr "Jednému alebo viacerým tímom bola priradená strana, ktorá nebola ani afirmatívna, ani negatívna."

#: draw/generator/random.py:193
msgid "Ranked solo draws require exactly one team per debate."
msgstr "Rangované sólové pairingy vyžadujú presne jeden tím na debatu."

#: draw/manager.py:61
#, python-format
msgid "The draw type %(type)s can't be used with two-team formats."
msgstr "Typ pairingu %(type)s sa nedá použiť s formátmi pre dva tímy."

#: draw/manager.py:63
#, python-format
msgid "The draw type %(type)s can't be used with British Parliamentary."
msgstr "Typ pairingu %(type)s sa nedá použiť s British Parliamentary."

#: draw/manager.py:65
#, python-format
msgid "Unrecognised \"teams in debate\" option: %(option)s"
msgstr "Nerozpoznaná možnosť \"tímy v debate\": %(option)s"

#: draw/manager.py:142
#, python-format
msgid "The odd-bracket method %(method)s requires side allocations before pairing."
msgstr "Metóda nepárneho koša %(method)s vyžaduje priradenie strán pred pairingom."

#: draw/manager.py:219
#, python-format
msgid "There are too many active teams without side pre-allocations for %(round)s. Assign all debating teams, or leave exactly %(count)d team unassigned to receive the bye."
msgstr "Pre %(round)s je príliš veľa aktívnych tímov bez predpriradenia strán. Priraď všetky debatujúce tímy, alebo nechaj presne %(count)d tím nepriradený, aby dostal bye."

#: draw/manager.py:326
msgid "Solo speech draws require at least one available side."
msgstr "Sólové rečnícke pairingy vyžadujú aspoň jednu dostupnú stranu."

#: draw/manager.py:339
msgid "Solo speech draws must have exactly one team in each debate."
msgstr "Sólové rečnícke pairingy musia mať presne jeden tím v každej debate."

#: draw/manager.py:347 draw/manager.py:353
msgid "Assign a saved affirmative/negative side for every active team before generating this solo speech draw."
msgstr "Priraď uloženú afirmatívnu/negatívnu stranu každému aktívnemu tímu pred generovaním tohto sólového rečníckeho pairingu."

#: draw/manager.py:533
msgid "Assign saved sides for every active team before using this bye-selection method with pre-allocated sides."
msgstr "Priraď uložené strany každému aktívnemu tímu pred použitím tejto metódy výberu bye s predpriradením strán."

#: draw/manager.py:538 draw/manager.py:620
msgid "This bye-selection method isn't supported for this draw configuration."
msgstr "Táto metóda výberu bye nie je podporovaná pre túto konfiguráciu pairingu."

#: draw/manager.py:615
msgid "This bye-selection method is only supported for one bye in two-team preliminary draws."
msgstr "Táto metóda výberu bye je podporovaná len pre jeden bye v predbežných pairingoch s dvoma tímami."

#: draw/manager.py:618
msgid "This bye-selection method isn't supported with the conflict-avoidance method that determines pullups itself."
msgstr "Táto metóda výberu bye nie je podporovaná s metódou vyhýbania sa konfliktom, ktorá sama určuje pull-upy."

#: draw/manager.py:636
msgid "This bye-selection method isn't supported for seeded draws."
msgstr "Táto metóda výberu bye nie je podporovaná pre nasadené pairingy."

#: draw/manager.py:733
#, python-format
msgid "The break size (%(size)d) for this break category was invalid. It must be either six times or four times a power of two."
msgstr "Veľkosť postupu (%(size)d) pre túto postupovú kategóriu je neplatná. Musí byť šesťnásobok alebo štvornásobok mocniny dvoch."

