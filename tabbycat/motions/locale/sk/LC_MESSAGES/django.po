#, python-format
msgid "χ² statistic is %(chisq).3f, providing insufficient evidence to suggest that this motion was imbalanced at any level of significance."
msgstr "χ² štatistika je %(chisq).3f, čo neposkytuje dostatočný dôkaz na to, aby sme tvrdili, že táto téza bola nevyvážená na akejkoľvek hladine významnosti."

