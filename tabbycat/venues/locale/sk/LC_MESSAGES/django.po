#: venues/apps.py
msgid "Rooms"
msgstr "Miestnosti"

#: venues/consumers.py
msgid "Draw is already released, unrelease draw to assign rooms."
msgstr "Pairing je už zverejnený. Zruš zverejnenie pairingu, aby si mohol priradiť miestnosti."

#: venues/consumers.py
msgid "Draw is not confirmed, confirm draw to assign rooms."
msgstr "Pairing nie je potvrdený. Potvrď pairing, aby si mohol priradiť miestnosti."

#: venues/consumers.py
msgid "Successfully auto-allocated rooms to debates."
msgstr "Miestnosti boli úspešne automaticky priradené k debatám."

#: venues/models.py
msgid "name"
msgstr "názov"

#: venues/models.py
msgid "priority"
msgstr "priorita"

#: venues/models.py
msgid "Rooms with a higher priority number will be preferred when allocating rooms to debates"
msgstr "Miestnosti s vyšším číslom priority budú uprednostnené pri priraďovaní miestností k debatám"

#: venues/models.py
msgid "tournament"
msgstr "turnaj"

#: venues/models.py
msgid "URL"
msgstr "URL"

#: venues/models.py
msgid "A URL that contains extra information about this room, e.g. a map or a meeting link (for online tournaments)"
msgstr "URL s ďalšími informáciami o tejto miestnosti, napr. mapa alebo odkaz na stretnutie (pre online turnaje)"

#: venues/models.py
msgid "room"
msgstr "miestnosť"

#: venues/models.py
msgid "rooms"
msgstr "miestnosti"

#: venues/models.py
msgid "Don't display in room name"
msgstr "Nezobrazovať v názve miestnosti"

#: venues/models.py
msgid "Display as prefix"
msgstr "Zobraziť ako predponu"

#: venues/models.py
msgid "Display as suffix"
msgstr "Zobraziť ako príponu"

#: venues/models.py
msgid "Name of category, e.g., \"Purple\", \"Step-free access\", \"Close to tab room\". This name is shown when the category is prefixed or suffixed to a room name in the draw, e.g., \"Purple – G05\"."
msgstr "Názov kategórie, napr. „Fialová”, „Bezbariérový prístup”, „Blízko tab room”. Tento názov sa zobrazuje, keď sa kategória pridáva ako predpona alebo prípona k názvu miestnosti v pairingu, napr. „Fialová – G05”."

#: venues/models.py
msgid "description"
msgstr "popis"

#: venues/models.py
msgid "Description, as the predicate of a sentence, e.g. \"has step-free access\", \"is close to the briefing hall\". This description follows \"This room\" when shown in tooltips, e.g., \"This room is close to the briefing hall.\"."
msgstr "Popis ako prísudok vety, napr. „má bezbariérový prístup”, „je blízko zasadačky”. Tento popis nasleduje za „Táto miestnosť” pri zobrazení v tiptitkách, napr. „Táto miestnosť je blízko zasadačky.”."

#: venues/models.py
msgid "display in room name"
msgstr "zobraziť v názve miestnosti"

#: venues/models.py
msgid "Prefix: \"Purple – G05\", Suffix: \"G05 – Purple\""
msgstr "Predpona: „Fialová – G05”, Prípona: „G05 – Fialová”"

#: venues/models.py
msgid "display in public tooltip"
msgstr "zobraziť vo verejnom tiptitku"

#: venues/models.py
msgid "Displays the description in the tooltip for the room on public pages. The description, if not blank, will always show on admin pages."
msgstr "Zobrazuje popis v tiptitku miestnosti na verejných stránkach. Popis, ak nie je prázdny, sa vždy zobrazí na admin stránkach."

#: venues/models.py
msgid "room category"
msgstr "kategória miestnosti"

#: venues/models.py
msgid "room categories"
msgstr "kategórie miestností"

#: venues/models.py
msgid "category"
msgstr "kategória"

#: venues/models.py
msgid "subject content type"
msgstr "typ obsahu subjektu"

#: venues/models.py
msgid "subject ID"
msgstr "ID subjektu"

#: venues/models.py
msgid "room constraint"
msgstr "obmedzenie miestnosti"

#: venues/models.py
msgid "room constraints"
msgstr "obmedzenia miestností"

#: venues/templates/venue_categories_edit.html
msgid "Room Categories"
msgstr "Kategórie miestností"

#: venues/templates/venue_categories_edit.html
msgid "Room categories allow you to group rooms together into \"zones\" to display in the draw and make navigation easier for participants, and/or specify constraints on room allocation that require teams, adjudicators or institutions to be put in a room in a particular category."
msgstr "Kategórie miestností ti umožňujú zoskupovať miestnosti do „zón” na zobrazenie v pairingu a uľahčenie orientácie účastníkom, a/alebo definovať obmedzenia priraďovania miestností, ktoré vyžadujú, aby tímy, rozhodcovia alebo inštitúcie boli v miestnosti určitej kategórie."

#: venues/templates/venue_categories_edit.html
#, python-format
msgid "If you want to delete room categories, use the <a href=\"%(edit_db_url)s\" class=\"alert-link\">Edit Database</a> area."
msgstr "Ak chceš vymazať kategórie miestností, použi oblasť <a href=\"%(edit_db_url)s\" class=\"alert-link\">Upraviť databázu</a>."

#: venues/templates/venue_categories_edit.html
msgid "Save Room Categories"
msgstr "Uložiť kategórie miestností"

#: venues/templates/venue_constraints_edit.html
msgid "Room Constraints"
msgstr "Obmedzenia miestností"

#: venues/templates/venue_constraints_edit.html
msgid "Room constraints tell the room allocator to try to keep the specified team or adjudicator, or all teams (but not adjudicators) from the specified institution, in a room in the given category. The \"priority\" field resolves conflicting constraints: the higher priority takes precedence. You can also use the priority field to specify \"lower-preference\" constraints, which are taken if a higher-priority constraint couldn't be met."
msgstr "Obmedzenia miestností inštruujú priraďovač miestností, aby sa pokúsil umiestniť zadaný tím alebo rozhodcu, alebo všetky tímy (nie rozhodcov) zo zadanej inštitúcie do miestnosti v danej kategórii. Pole „priorita” rieši konfliktné obmedzenia: vyššia priorita má prednosť. Pole priorita môžeš použiť aj na definovanie obmedzení s „nižšou preferenciou”, ktoré sa uplatnia, ak obmedzenie s vyššou prioritou nemohlo byť splnené."

#: venues/templates/venue_constraints_edit.html
msgid "Save Room Constraints"
msgstr "Uložiť obmedzenia miestností"

#: venues/utils.py
#, python-format
msgid "Room constraint of %(name)s met (%(category)s)"
msgstr "Obmedzenie miestnosti pre %(name)s splnené (%(category)s)"

#: venues/utils.py
#, python-format
msgid "Room does not meet any constraint of %(name)s"
msgstr "Miestnosť nespĺňa žiadne obmedzenie pre %(name)s"

#: venues/utils.py
#, python-format
msgid "Room constraint of %(team)s met (%(category)s, via institution %(institution)s)"
msgstr "Obmedzenie miestnosti pre %(team)s splnené (%(category)s, cez inštitúciu %(institution)s)"

#: venues/utils.py
#, python-format
msgid "Room does not meet any constraint of institution %(institution)s (%(team)s)"
msgstr "Miestnosť nespĺňa žiadne obmedzenie inštitúcie %(institution)s (%(team)s)"

#: venues/views.py
msgid "Edit Rooms"
msgstr "Upraviť miestnosti"

#: venues/views.py
#, python-format
