msgid_plural "Saved venue categories: %(list)s"
msgstr[0] "Uložená kategória miestnosti: %(list)s"
msgstr[1] "Uložené kategórie miestností: %(list)s"
msgstr[2] "Uložené kategórie miestností: %(list)s"
msgstr[3] "Uložených kategórií miestností: %(list)s"

#: venues/views.py
msgid "No changes were made to the room categories."
msgstr "V kategóriách miestností neboli vykonané žiadne zmeny."

#: venues/views.py
#, python-format
msgid "%s (Adjudicator)"
msgstr "%s (rozhodca)"

#: venues/views.py
#, python-format
msgid "%s (Team)"
msgstr "%s (tím)"

#: venues/views.py
#, python-format
msgid "%s (Institution)"
msgstr "%s (inštitúcia)"

#: venues/views.py
#, python-format
msgid "Saved %(count)d room constraint."
msgid_plural "Saved %(count)d room constraints."
msgstr[0] "Uložené %(count)d obmedzenie miestnosti."
msgstr[1] "Uložené %(count)d obmedzenia miestností."
msgstr[2] "Uložené %(count)d obmedzenia miestností."
msgstr[3] "Uložených %(count)d obmedzení miestností."
