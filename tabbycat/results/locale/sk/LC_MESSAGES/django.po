#: results/admin.py
msgid "Resave results"
msgstr "Znovu uložiť výsledky"

#: results/admin.py
#, python-format
msgid "Resaved results for %(count)d ballot submission."
msgid_plural "Resaved results for %(count)d ballot submissions."
msgstr[0] "Znovu uložené výsledky pre %(count)d odovzdanie ballotu."
msgstr[1] "Znovu uložené výsledky pre %(count)d odovzdania ballotov."
msgstr[2] "Znovu uložené výsledky pre %(count)d odovzdaní ballotov."
msgstr[3] "Znovu uložené výsledky pre %(count)d odovzdaní ballotov."

#: results/admin.py
msgid "Speaker"
msgstr "Rečník"

#: results/apps.py results/templates/public_results_index.html results/views.py
msgid "Results"
msgstr "Výsledky"

#: results/forms.py
msgid "Tournament password"
msgstr "Heslo pre turnaj"

#: results/forms.py
msgid "That password isn't correct."
msgstr "Heslo je nesprávne."

#: results/forms.py
msgid "The ballot set can't be both discarded and confirmed."
msgstr "Set ballotov nemôže byť naraz potvrdený aj zahodený."

#: results/forms.py
msgid "The debate status can't be confirmed unless one of the ballot sets is confirmed."
msgstr "Stav debaty nemôže byť potvrdený, pokiaľ nie je potvrdený aspoň jeden set ballotov."

#: results/forms.py
msgid "---------"
msgstr "---------"

#: results/forms.py
#, python-format
msgid "%(aff_team)s affirmed, %(neg_team)s negated"
msgstr "%(aff_team)s debatoval súhlas, %(neg_team)s debatoval nesúhlas"

#: results/forms.py
#, python-format
msgid "%(side)s's motion veto"
msgstr "Veto tézy strany %(side)s"

#: results/forms.py
#, python-format
msgid "%(team)s (%(side)s)"
msgstr "%(team)s (%(side)s)"

#: results/forms.py
msgid "Winner"
msgstr "Víťaz"

#: results/forms.py
msgid "Mark as a duplicate speech"
msgstr "Označiť reč ako duplicitnú"

#: results/forms.py
msgid "Only one team can forfeit"
msgstr "Iba jeden tím sa môže vzdať"

#: results/forms.py
msgid "This field is required."
msgstr "Toto pole je povinné."

#: results/forms.py
#, python-format
msgid "The speaker %(speaker)s doesn't appear to be on team %(team)s."
msgstr "Zdá sa, že rečník %(speaker)s nie je v tíme %(team)s."

#: results/forms.py
#, python-format
msgid "%(speaker)s appears to have given %(count)d substantive speech."
msgid_plural "%(speaker)s appears to have given %(count)d substantive speeches."
msgstr[0] "Zdá sa, že %(speaker)s mal/a %(count)d substantívnu reč."
msgstr[1] "Zdá sa, že %(speaker)s mal/a %(count)d substantívne reči."
msgstr[2] "Zdá sa, že %(speaker)s mal/a %(count)d substantívnych rečí."
msgstr[3] "Zdá sa, že %(speaker)s mal/a %(count)d substantívnych rečí."

#: results/forms.py
msgid "The last substantive speaker and reply speaker can't be the same."
msgstr "Posledný substantívny rečník a rečník záverečnej reči nemôžu byť rovnakí."

#: results/forms.py
msgid "The reply speaker for this team did not give a substantive speech."
msgstr "Rečník záverečnej reči za tento tím nemal substantívnu reč."

#: results/forms.py
msgid "The total scores for the teams are the same (i.e. a draw)."
msgstr "Celkové body tímov sú rovnaké (t. j. remíza)."

#: results/forms.py
msgid "The declared winner does not correspond to the team with the highest score."
msgstr "Označený víťaz nezodpovedá tímu s najvyšším skóre."

#: results/forms.py
#, python-format
msgid "The total scores for the following teams are the same: %(teams)s"
msgstr "Celkové body nasledujúcich tímov sú rovnaké: %(teams)s"

#: results/forms.py
#, python-format
msgid "The margin (%(margin).1f) exceeds the maximum allowable margin (%(max_margin).1f)."
msgstr "Bodový rozdiel (%(margin).1f) prekračuje maximálny povolený rozdiel (%(max_margin).1f)."

#: results/forms.py
msgid "Ranks cannot be tied."
msgstr "Poradia nemôžu byť zhodné."

#: results/forms.py
msgid "Ranks must correspond to speaker scores"
msgstr "Poradia musia zodpovedať rečníckym bodom"

#: results/forms.py
#, python-format
msgid "The total scores for the teams are the same (i.e. a draw) for adjudicator %(adjudicator)s."
msgstr "Celkové body tímov sú rovnaké (t. j. remíza) pri rozhodcovi %(adjudicator)s."

#: results/forms.py
#, python-format
msgid "The declared winner does not correspond to the team with the highest score for adjudicator %(adjudicator)s."
msgstr "Označený víťaz nezodpovedá tímu s najvyšším skóre pri rozhodcovi %(adjudicator)s."

#: results/forms.py
#, python-format
msgid "The margin (%(margin).1f) in the ballot of adjudicator %(adjudicator)s exceeds the maximum allowable margin (%(max_margin).1f)."
msgstr "Bodový rozdiel (%(margin).1f) v ballote rozhodcu %(adjudicator)s prekračuje maximálny povolený rozdiel (%(max_margin).1f)."

#: results/forms.py
msgid "Sides for this debate are not confirmed. You can't save a result for this debate until the sides have been confirmed in the draw."
msgstr "Strany v tejto debate nie sú potvrdené. Výsledok pre túto debatu nemôžeš uložiť, kým strany nebudú potvrdené v pairingu."

#: results/forms.py
#, python-format
msgid "There must be exactly %(n)d team advancing."
msgid_plural "There must be exactly %(n)d teams advancing."
msgstr[0] "Musí postupovať presne %(n)d tím."
msgstr[1] "Musia postupovať presne %(n)d tímy."
msgstr[2] "Musí postupovať presne %(n)d tímov."
msgstr[3] "Musí postupovať presne %(n)d tímov."

#: results/forms.py
msgid "There must be exactly 1 team advancing."
msgstr "Musí postúpiť presne 1 tím."

