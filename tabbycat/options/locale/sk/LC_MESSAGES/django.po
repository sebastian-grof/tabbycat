#: options/apps.py
msgid "Tournament Options"
msgstr "Nastavenia turnaja"

#: options/forms.py
msgid "Mininum score must be less than maximum score"
msgstr "Minimálne skóre musí byť nižšie ako maximálne skóre"

#: options/forms.py
msgid "Intermediate 1 or 2 require preallocated sides"
msgstr "Intermediate 1 alebo 2 vyžadujú vopred priradené strany"

#: options/forms.py
msgid "Four-team formats require consensus ballots"
msgstr "Formáty so štyrmi tímami vyžadujú konsenzuálne balloty"

#: options/forms.py
msgid "Must set a password if using a password is enabled"
msgstr "Ak je vyžadované heslo, musíš ho nastaviť"

#: options/forms.py
msgid "Showing team institutions defeats the purpose of code names"
msgstr "Zobrazovanie inštitúcií tímov popiera zmysel kódových názvov"

#: options/models.py
msgid "instance"
msgstr "inštancia"

#: options/models.py
msgid "tournament preference"
msgstr "nastavenie turnaja"

#: options/models.py
msgid "tournament preferences"
msgstr "nastavenia turnaja"

#: options/preferences.py options/templates/preferences_index.html
msgid "Score Rules"
msgstr "Pravidlá bodov"

#: options/preferences.py
msgid "Minimum allowed score for substantive speeches"
msgstr "Minimálne povolené skóre pre substantívne reči"

#: options/preferences.py
msgid "Minimum speaker score"
msgstr "Minimálne skóre rečníka/rečníčky"

#: options/preferences.py
msgid "Maximum speaker score"
msgstr "Maximálne skóre rečníka/rečníčky"

#: options/preferences.py
msgid "Maximum allowed score for substantive speeches"
msgstr "Maximálne povolené skóre pre substantívne reči"

#: options/preferences.py
msgid "Speaker score step"
msgstr "Krok skóre rečníka/rečníčky"

#: options/preferences.py
msgid "Score steps allowed for substantive speeches, e.g. full points (1) or half points (0.5)"
msgstr "Povolené kroky skóre pre substantívne reči, napr. celé body (1) alebo polovičné body (0.5)"

#: options/preferences.py
msgid "The largest amount by which one team can beat another (0 means no limit)"
msgstr "Maximálny rozdiel bodov, o ktorý môže jeden tím poraziť druhý (0 znamená bez obmedzenia)"

#: options/preferences.py
msgid "Maximum margin"
msgstr "Maximálny rozdiel"

#: options/preferences.py
msgid "Minimum allowed score for reply speeches"
msgstr "Minimálne povolené skóre pre záverečné reči"

#: options/preferences.py
msgid "Minimum reply score"
msgstr "Minimálne skóre záverečnej reči"

#: options/preferences.py
msgid "Maximum allowed score for reply speeches"
msgstr "Maximálne povolené skóre pre záverečné reči"

#: options/preferences.py
msgid "Maximum reply score"
msgstr "Maximálne skóre záverečnej reči"

#: options/preferences.py
msgid "Score steps allowed for reply speeches, e.g. full points (1) or half points (0.5)"
msgstr "Povolené kroky skóre pre záverečné reči, napr. celé body (1) alebo polovičné body (0.5)"

#: options/preferences.py
msgid "Reply score step"
msgstr "Krok skóre záverečnej reči"

#: options/preferences.py
msgid "If checked, a team's winning margin includes dissenting adjudicators"
msgstr "Ak je zaškrtnuté, rozdiel víťazného tímu zahŕňa aj nesúhlasiacich rozhodcov/rozhodkyne"

#: options/preferences.py
msgid "Margin includes dissenters"
msgstr "Rozdiel zahŕňa nesúhlasiacich"

#: options/preferences.py
msgid "Any explanatory text needed to introduce the ballot form, e.g. speaker scale"
msgstr "Akýkoľvek vysvetľujúci text k formuláru ballotu, napr. bodovacia škála"

#: options/preferences.py
msgid "Ballot introduction/explanation"
msgstr "Úvod/vysvetlenie ballotu"

#: options/preferences.py
msgid "If checked, all speaker scores, including for duplicate speeches, will be counted for team scores"
msgstr "Ak je zaškrtnuté, všetky rečnícke body vrátane duplicitných rečí sa zarátajú do tímového skóre"

#: options/preferences.py
msgid "Team score includes ghosts"
msgstr "Tímové skóre zahŕňa duplikáty"

#: options/preferences.py options/templates/preferences_index.html
msgid "Draw Rules"
msgstr "Pravidlá pairingu"

#: options/preferences.py
msgid "The auto-allocator will only take adjudicators at or above this score as voting panellists"
msgstr "Automatický prideľovač bude brať ako hlasujúcich panelistov len rozhodcov/rozhodkyne s týmto skóre alebo vyšším"

#: options/preferences.py
msgid "Minimum adjudicator score to vote"
msgstr "Minimálne skóre rozhodcu/rozhodkyne na hlasovanie"

#: options/preferences.py
msgid "Penalty applied by adjudicator auto-allocator for conflicts"
msgstr "Penalizácia automatického prideľovača rozhodcov/rozhodkýň za konflikty"

#: options/preferences.py
msgid "Adjudicator conflict penalty"
msgstr "Penalizácia za konflikt rozhodcu/rozhodkyne"

#: options/preferences.py
msgid "Penalty applied by adjudicator auto-allocator for history"
msgstr "Penalizácia automatického prideľovača rozhodcov/rozhodkýň za históriu"

#: options/preferences.py
msgid "Adjudicator history penalty"
msgstr "Penalizácia za históriu rozhodcu/rozhodkyne"

#: options/preferences.py
msgid "Penality applied by preformed panel auto-allocator for priority mismatch"
msgstr "Penalizácia automatického prideľovača predpripravených panelov za nesúlad priorít"

#: options/preferences.py
msgid "Importance mismatch penalty"
msgstr "Penalizácia za nesúlad dôležitosti"

#: options/preferences.py
msgid "Penalty applied by conflict avoidance method for teams seeing their own institution"
msgstr "Penalizácia metódy vyhýbania sa konfliktom za stretnutie tímov z rovnakej inštitúcie"

#: options/preferences.py
msgid "Team institution penalty"
msgstr "Penalizácia za inštitúciu tímu"

#: options/preferences.py
msgid "Penalty applied by conflict avoidance method for teams seeing each other twice or more"
msgstr "Penalizácia metódy vyhýbania sa konfliktom za opakované stretnutia tímov"

#: options/preferences.py
msgid "Team history penalty"
msgstr "Penalizácia za históriu tímu"

#: options/preferences.py
msgid "If checked, the draw will try to avoid pairing teams against their own institution"
msgstr "Ak je zaškrtnuté, pairing sa pokúsi vyhnúť stretnutiu tímov z rovnakej inštitúcie"

#: options/preferences.py
msgid "Avoid same institution"
msgstr "Vyhýbať sa rovnakej inštitúcii"

#: options/preferences.py
msgid "If checked, the draw will try to avoid having teams see each other twice"
msgstr "Ak je zaškrtnuté, pairing sa pokúsi vyhnúť opakovanému stretnutiu tímov"

#: options/preferences.py
msgid "Avoid team history"
msgstr "Vyhýbať sa histórii tímu"

#: options/preferences.py
msgid "Penalty applied by conflict avoidance method for teams being in a pullup many times. Leave 0 for no penalty."
msgstr "Penalizácia metódy vyhýbania sa konfliktom za opakované pullup tímov. Nechaj 0 pre žiadnu penalizáciu."

#: options/preferences.py
msgid "Previously saw pullup penalty"
msgstr "Penalizácia za predchádzajúci pullup"

#: options/preferences.py
msgid "Penalty applied by minimum cost matching to prefer pairings that balance sides."
msgstr "Penalizácia párovacieho algoritmu minimálnych nákladov na uprednostnenie pairingov, ktoré vyvážia strany."

#: options/preferences.py
msgid "Side balance penalty"
msgstr "Penalizácia za nevyváženie strán"

#: options/preferences.py
msgid "Penalty applied by minimum cost matching to prefer pairings that follow the draw pairing method."
msgstr "Penalizácia párovacieho algoritmu minimálnych nákladov na uprednostnenie pairingov zodpovedajúcich metóde pairingu."

#: options/preferences.py
msgid "Pairing deviation penalty"
msgstr "Penalizácia za odchýlku pairingu"

#: options/preferences.py
msgid "Hard preference applied by minimum cost matching to disallow pairings where a team would debate                   more than this many times on the same side. WARNING: if you set this to a low value, the draw                   algorithm may be unable to find a valid draw."
msgstr "Pevné obmedzenie párovacieho algoritmu minimálnych nákladov zakazujúce pairingy, pri ktorých by tím debatoval viac ako toľkokrát na rovnakej strane. POZOR: ak nastavíš nízku hodnotu, algoritmus pairingu nemusí byť schopný nájsť platný pairing."

#: options/preferences.py
msgid "Maximum number of times per side"
msgstr "Maximálny počet opakovaní na jednej strane"

#: options/preferences.py
msgid "How odd brackets are resolved (see documentation for further details)"
msgstr "Ako sa riešia nepárne koše (ďalšie podrobnosti nájdeš v dokumentácii)"

#: options/preferences.py
msgid "Odd bracket resolution method"
msgstr "Metóda riešenia nepárnych košov"

#: options/preferences.py
msgid "Pull up from top"
msgstr "Pullup zhora"

#: options/preferences.py
msgid "Pull up from bottom"
msgstr "Pullup zdola"

#: options/preferences.py
msgid "Pull up from middle"
msgstr "Pullup zo stredu"

#: options/preferences.py
msgid "Pull up at random"
msgstr "Náhodný pullup"

#: options/preferences.py
msgid "Intermediate brackets"
msgstr "Medzikošové párovania"

#: options/preferences.py
msgid "Intermediate brackets with bubble-up-bubble-down"
msgstr "Medzikošové párovania s bubble-up-bubble-down"

#: options/preferences.py
msgid "Intermediate 1 (pre-allocated sides)"
msgstr "Intermediate 1 (vopred priradené strany)"

#: options/preferences.py
msgid "Intermediate 2 (pre-allocated sides)"
msgstr "Intermediate 2 (vopred priradené strany)"

#: options/preferences.py
msgid "Pull up from the lowest draw strength by rank"
msgstr "Pullup tímu s najnižšou silou pairingu podľa poradia"

#: options/preferences.py
msgid "Pull up from the least pulled up, then the lowest draw strength by rank"
msgstr "Pullup tímu, ktorý bol pullupnutý najmenej, potom podľa najnižšej sily pairingu"

#: options/preferences.py
msgid "How affirmative/negative positions are assigned (see documentation for further details)"
msgstr "Ako sa prideľujú pozície kladnej/zápornej strany (ďalšie podrobnosti nájdeš v dokumentácii)"

#: options/preferences.py
msgid "Side allocations method"
msgstr "Metóda prideľovania strán"

#: options/preferences.py
msgid "Random"
msgstr "Náhodne"

#: options/preferences.py
msgid "Balance"
msgstr "Vyvažovanie"

#: options/preferences.py
msgid "Pre-allocated"
msgstr "Vopred priradené"

#: options/preferences.py
msgid "Manually enter from ballot"
msgstr "Ručne zadať z ballotu"

#: options/preferences.py
msgid "Slide: 1 vs 6, 2 vs 7, …. Fold: 1 vs 10, 2 vs 9, …. Adjacent: 1 vs 2, 3 vs 4, …."
msgstr "Slide: 1 vs 6, 2 vs 7, …. Fold: 1 vs 10, 2 vs 9, …. Adjacent: 1 vs 2, 3 vs 4, …."

#: options/preferences.py
msgid "Pairing method"
msgstr "Metóda pairingu"

#: options/preferences.py
msgid "Slide"
msgstr "Slide"

#: options/preferences.py
msgid "Fold"
msgstr "Fold"

#: options/preferences.py
msgid "Adjacent"
msgstr "Adjacent"

#: options/preferences.py
msgid "Fold top, adjacent rest"
msgstr "Fold top, adjacent zvyšok"

#: options/preferences.py
msgid "Method used to try to avoid teams facing each other multiple times or their own institution (see documentation for further details)"
msgstr "Metóda na vyhýbanie sa opakovaným stretnutiam tímov alebo stretnutiam s vlastnou inštitúciou (ďalšie podrobnosti nájdeš v dokumentácii)"

#: options/preferences.py
msgid "Conflict avoidance method"
msgstr "Metóda vyhýbania sa konfliktom"

#: options/preferences.py
msgid "Off"
msgstr "Vypnuté"

#: options/preferences.py
msgid "One-up-one-down"
msgstr "One-up-one-down"

#: options/preferences.py
msgid "Minimum cost matching (pullups determined beforehand)"
msgstr "Párovania minimálnych nákladov (pullup určený vopred)"

#: options/preferences.py
msgid "Minimum cost matching (including pullups)"
msgstr "Párovania minimálnych nákladov (vrátane pullupu)"

#: options/preferences.py
msgid "If using pull-ups, restrict which teams can be pulled up. Two-team formats only. Has no effect on BP or intermediate brackets."
msgstr "Ak sa používajú pullup tímy, obmedz, ktoré tímy môžu byť pullupnuté. Len pre formáty s dvoma tímami. Nemá účinok na BP ani medzikošové párovania."

#: options/preferences.py
msgid "Pullup restriction"
msgstr "Obmedzenie pullupu"

#: options/preferences.py
msgid "No restriction"
msgstr "Bez obmedzenia"

#: options/preferences.py
msgid "Choose from teams who have been pulled up the fewest times so far"
msgstr "Vybrať z tímov, ktoré boli doteraz pullupnuté najmenej"

#: options/preferences.py
msgid "Choose from teams with the lowest draw strength by wins so far"
msgstr "Vybrať z tímov s najnižšou silou pairingu podľa výhier"

#: options/preferences.py
msgid "Choose from teams with the lowest draw strength by speaks so far"
msgstr "Vybrať z tímov s najnižšou silou pairingu podľa rečníckych bodov"

#: options/preferences.py
msgid "Penalty applied when determining which teams to pull up (for minimum cost matching)"
msgstr "Penalizácia pri určovaní, ktoré tímy pullupnúť (pre párovania minimálnych nákladov)"

#: options/preferences.py
msgid "Pullup penalty"
msgstr "Penalizácia za pullup"

#: options/preferences.py
msgid "In BP, how pullups are distributed. Only \"Anywhere\" is WUDC-compliant."
msgstr "V BP, ako sa pullup tímy rozdeľujú. Len 'Kdekoľvek' je v súlade s pravidlami WUDC."

#: options/preferences.py
msgid "BP pullup distribution"
msgstr "Rozdelenie pullupu v BP"

#: options/preferences.py
msgid "Anywhere in bracket"
msgstr "Kdekoľvek v koši"

#: options/preferences.py
msgid "All in the same room (not WUDC-compliant)"
msgstr "Všetci v rovnakej miestnosti (nie je v súlade s WUDC)"

#: options/preferences.py
msgid "In BP, which position cost function to use (see documentation for details)"
msgstr "V BP, ktorú funkciu nákladov na pozíciu použiť (podrobnosti nájdeš v dokumentácii)"

#: options/preferences.py
msgid "BP position cost"
msgstr "Náklady na pozíciu v BP"

#: options/preferences.py
msgid "Simple"
msgstr "Jednoduchý"

#: options/preferences.py
msgid "Rényi entropy"
msgstr "Rényiho entropia"

#: options/preferences.py
msgid "Population variance"
msgstr "Rozptyl populácie"

#: options/preferences.py
msgid "Rényi order α, if BP position cost uses Rényi entropy. Shannon is α = 1, Hartley is α = 0, collision is α = 2. See documentation for details."
msgstr "Rényiho rád α, ak náklady na pozíciu v BP používajú Rényiho entropiu. Shannon je α = 1, Hartley je α = 0, kolízia je α = 2. Podrobnosti nájdeš v dokumentácii."

#: options/preferences.py
msgid "Rényi order (BP)"
msgstr "Rényiho rád (BP)"

#: options/preferences.py
msgid "The BP position cost is raised to this power; higher exponents bias towards resolving fewer large position imbalances over more small ones. See documentation for details."
msgstr "Náklady na pozíciu v BP sa umocnia na túto hodnotu; vyššie exponenty uprednostňujú riešenie menšieho počtu väčších nerovnováh pozícií pred väčším počtom menších. Podrobnosti nájdeš v dokumentácii."

#: options/preferences.py
msgid "BP position cost exponent"
msgstr "Exponent nákladov na pozíciu v BP"

#: options/preferences.py
msgid "In BP, which method to use to solve the assignment problem. Only Hungarian with preshuffling is WUDC-compliant."
msgstr "V BP, ktorú metódu použiť na riešenie problému priradenia. Len maďarský algoritmus s predsortovaním je v súlade s WUDC."

#: options/preferences.py
msgid "BP assignment method"
msgstr "Metóda priradenia v BP"

#: options/preferences.py
msgid "Hungarian algorithm (not WUDC-compliant)"
msgstr "Maďarský algoritmus (nie je v súlade s WUDC)"

#: options/preferences.py
msgid "Hungarian algorithm with preshuffling"
msgstr "Maďarský algoritmus s predsortovaním"

#: options/preferences.py
msgid "Automatically make all adjudicators available for all rounds"
msgstr "Automaticky sprístupniť všetkých rozhodcov/rozhodkyne pre všetky kolá"

#: options/preferences.py
msgid "Skip adjudicator check-ins"
msgstr "Preskočiť registráciu rozhodcov/rozhodkýň"

#: options/preferences.py
msgid "Hide panellist positions in the UI (and don't allocate them)"
msgstr "Skryť pozície panelistov v rozhraní (a nepridzovať ich)"

#: options/preferences.py
msgid "No panellist adjudicators"
msgstr "Žiadni panelisti"

#: options/preferences.py
msgid "Hide trainee positions in the UI (and don't allocate them)"
msgstr "Skryť pozície shadowov v rozhraní (a nepridzovať ich)"

#: options/preferences.py
msgid "No trainee adjudicators"
msgstr "Žiadni shadows"

#: options/preferences.py
msgid "How to handle teams who were marked available yet excluded froma round (a bye)"
msgstr "Ako nakladať s tímami, ktoré boli označené ako dostupné, ale vynechané z kola (bye)"

#: options/preferences.py
msgid "Bye team results"
msgstr "Výsledky tímov s bye"

#: options/preferences.py
msgid "Treat bye teams as absent"
msgstr "Zaobchádzať s bye tímami ako s neprítomné"

#: options/preferences.py
msgid "Attribute a win to bye teams, without speaks"
msgstr "Priradiť bye tímom výhru bez rečníckych bodov"

#: options/preferences.py
msgid "If creating a draw with an uneven number of teams, how to decide who gets the bye (won't be allocated)"
msgstr "Ak je pairing vytváraný pre nepárny počet tímov, ako rozhodnúť, ktorý tím dostane bye (nebude zaradený do pairingu)"

#: options/preferences.py
msgid "Bye team selection method"
msgstr "Metóda výberu tímu pre bye"

#: options/preferences.py
msgid "Don't choose bye teams"
msgstr "Nevyberať tímy pre bye"

#: options/preferences.py
msgid "Choose bye teams randomly"
msgstr "Vybrať tímy pre bye náhodne"

#: options/preferences.py
msgid "Choose lowest ranking teams"
msgstr "Vybrať tímy s najnižším poradím"

#: options/preferences.py
msgid "A limit for the side imbalance, where a pairing will not be made if that requires a team to debate more times on one side than the selected number. For use with the graph generator, with 0 as disabled."
msgstr "Limit pre nevyváženie strán — pairing nebude vytvorený, ak by si tím vyžadoval debatovaťna jednej strane viac ako tento počet krát. Určené pre generátor grafov, 0 znamená vypnuté."

#: options/preferences.py
msgid "Maximum allowed side imbalance"
msgstr "Maximálne povolené nevyváženie strán"

#: options/preferences.py options/templates/preferences_index.html
msgid "Feedback"
msgstr "Spätná väzba"

#: options/preferences.py
msgid "Minimum possible adjudicator score that can be given"
msgstr "Minimálne možné skóre rozhodcu/rozhodkyne"

#: options/preferences.py
msgid "Minimum adjudicator score"
msgstr "Minimálne skóre rozhodcu/rozhodkyne"

#: options/preferences.py
msgid "Maximum possible adjudicator score that can be given"
msgstr "Maximálne možné skóre rozhodcu/rozhodkyne"

#: options/preferences.py
msgid "Maximum adjudicator score"
msgstr "Maximálne skóre rozhodcu/rozhodkyne"

#: options/preferences.py
msgid "Used to inform available choices in the feedback forms for adjudicators (both online and printed) and feedback progress"
msgstr "Určuje dostupné možnosti vo formulároch spätnej väzby pre rozhodcov/rozhodkyne (online aj tlačené) a sledovanie pokroku spätnej väzby"

#: options/preferences.py
msgid "Allow and expect feedback to be submitted by"
msgstr "Povoliť a očakávať odoslanie spätnej väzby od"

#: options/preferences.py
msgid "Chairs on panellists and trainees"
msgstr "Chair na panelistov a shadowov"

#: options/preferences.py
msgid "Panellists on chairs, chairs on panellists and trainees"
msgstr "Panelisti na chairov, chair na panelistov a shadowov"

#: options/preferences.py
msgid "Panellists and trainees on chairs, chairs on panellists and trainees"
msgstr "Panelisti a shadows na chairov, chair na panelistov a shadowov"

#: options/preferences.py
msgid "All adjudicators (including trainees) on each other"
msgstr "Všetci rozhodcovia/rozhodkyne (vrátane shadowov) navzájom"

#: options/preferences.py
msgid "Panellists on eachother and chairs, trainees on chairs, chairs on everyone"
msgstr "Panelisti navzájom a na chairov, shadows na chairov, chair na všetkých"

#: options/preferences.py
msgid "Neither chairs, nor panellists nor trainees"
msgstr "Ani chair, ani panelisti, ani shadows"

#: options/preferences.py
msgid "Expect feedback to be submitted by teams on"
msgstr "Očakávať odoslanie spätnej väzby tímmi na"

#: options/preferences.py
msgid "Used to inform available choices in the feedback forms for teams (both online and printed) and feedback progress; this option is used by, e.g., UADC"
msgstr "Určuje dostupné možnosti vo formulároch spätnej väzby pre tímy (online aj tlačené) a sledovanie pokroku; túto možnosť používa napr. UADC"

#: options/preferences.py
msgid "Orallist only (voting panellists permitted, with prompts to select orallist)"
msgstr "Len oralista (hlasujúci panelisti povolení, s výzvou na výber oralistu)"

#: options/preferences.py
msgid "All adjudicators in their panels (including trainees)"
msgstr "Všetci rozhodcovia/rozhodkyne vo svojich paneloch (vrátane shadowov)"

#: options/preferences.py
msgid "No one"
msgstr "Nikto"

#: options/preferences.py
msgid "Show unexpected feedback submissions in participants pages"
msgstr "Zobraziť neočakávané odoslania spätnej väzby na stránkach účastníkov"

#: options/preferences.py
msgid "Displays unexpected feedback with a question mark symbol; only relevant if public participants and feedback progress are both enabled"
msgstr "Zobrazuje neočakávanú spätnú väzbu so symbolom otáznika; relevantné len ak sú zapnutí verejní účastníci aj sledovanie pokroku spätnej väzby"

#: options/preferences.py
msgid "Show if an adjudicator is a trainee (unaccredited)"
msgstr "Zobraziť, či je rozhodca/rozhodkyňa shadow (neakreditovaný/-á)"

#: options/preferences.py
msgid "Show unaccredited"
msgstr "Zobraziť neakreditovaných"

#: options/preferences.py
msgid "Any explanatory text needed to introduce the feedback form"
msgstr "Akýkoľvek vysvetľujúci text k formuláru spätnej väzby"

#: options/preferences.py
msgid "Feedback introduction/explanation"
msgstr "Úvod/vysvetlenie spätnej väzby"

#: options/preferences.py options/templates/preferences_index.html
msgid "Debate Rules"
msgstr "Pravidlá debaty"

#: options/preferences.py
msgid "How many teams are in each debate (normally 2 but 4 for BP)"
msgstr "Počet tímov v každej debate (zvyčajne 2, pre BP 4)"

#: options/preferences.py
msgid "Number of teams per debate"
msgstr "Počet tímov na debatu"

#: options/preferences.py
msgid "Whether panels submit a ballot each or a single ballot for a debate during the preliminary rounds. Note: BP must use one per debate."
