msgid ""
"3 vs 3 with replies, chosen motions, intermediate brackets, one-up-one-down."
" Compliant with AIDA rules."
msgstr ""
"3 vs 3 so záverečnými rečami, vybranými tézami, medzikošovými párovaniami, "
"one-up-one-down. V súlade s pravidlami AIDA."

#: options/presets.py:211
msgid "British Parliamentary Rules"
msgstr "British Parliamentary pravidlá"

#: options/presets.py:212
msgid "2 vs 2 vs 2 vs 2. Compliant with WUDC rules."
msgstr "2 vs 2 vs 2 vs 2. V súlade s pravidlami WUDC."

#: options/presets.py:259
msgid "Canadian Parliamentary Rules"
msgstr "Canadian Parliamentary pravidlá"

#: options/presets.py:261
msgid ""
"2 vs 2 with replies (unscored) and POIs. May require additional "
"configuration depending on regional variations."
msgstr ""
"2 vs 2 so záverečnými rečami (bez bodov) a POI. Môže vyžadovať ďalšiu "
"konfiguráciu podľa regionálnych odchýlok."

#: options/presets.py:284
msgid "Australian Easters Rules"
msgstr "Australian Easters pravidlá"

#: options/presets.py:286
msgid ""
"3 vs 3 without replies, set motions, novices, intermediate bubbles, one-up-"
"one-down. Compliant with AIDA rules."
msgstr ""
"3 vs 3 bez záverečných rečí, stanovené tézy, nováčikovia, medzikošové "
"bubliny, one-up-one-down. V súlade s pravidlami AIDA."

#: options/presets.py:304
msgid "2 vs 2 Impromptu"
msgstr "2 vs 2 Impromptu"

#: options/presets.py:306
msgid ""
"2 vs 2 with replies, chosen motions, chosen sides, and novice statuses."
msgstr ""
"2 vs 2 so záverečnými rečami, vybranými tézami, vybranými stranami a "
"štatútmi nováčikov."

#: options/presets.py:331
msgid "3 vs 3 Prepared"
msgstr "3 vs 3 Prepared"

#: options/presets.py:333
msgid ""
"3 vs 3 with preallocated sides, publicly displayed sides and motions, and "
"novice statuses."
msgstr ""
"3 vs 3 s vopred priradenými stranami, verejne zobrazenými stranami a tézami "
"a štatútmi nováčikov."

