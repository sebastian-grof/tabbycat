#, python-format
msgid "Tournament options (%(section)s) saved."
msgstr "Nastavenia turnaja (%(section)s) uložené."

#: options/views.py:90
#, python-format
msgid "Apply Preset: %s"
msgstr "Použiť prednastavenie: %s"

#: options/views.py:108
#, python-format
msgid "Tournament options saved based on preset %(name)s."
msgstr "Nastavenia turnaja uložené podľa prednastavenia %(name)s."

