#: options/apps.py:10
msgid "Tournament Options"
msgstr "Nastavenia turnaja"

#: options/forms.py:36
msgid "Median scoring requires Tabbycat default adjudicator weighting."
msgstr ""
"Mediánové hodnotenie vyžaduje predvolené váhovanie rozhodcov Tabbycatu."

#: options/forms.py:38
msgid "Self-split ballots require Tabbycat default adjudicator weighting."
msgstr ""
"Hlasovacie lístky s rozhodnutím 2 : 1 od jediného rozhodcu vyžadujú "
"predvolené váhovanie rozhodcov Tabbycatu."

#: options/forms.py:40
msgid "Self-split ballots require two teams per debate."
msgstr "Rozhodnutie 2 : 1 od jediného rozhodcu vyžaduje dva tímy v debate."

#: options/forms.py:42
msgid "Minimum score must be less than maximum score"
msgstr "Minimálne skóre musí byť nižšie ako maximálne skóre"

#: options/forms.py:53
msgid "Intermediate 1 or 2 require preallocated sides"
msgstr "Intermediate 1 alebo 2 vyžadujú vopred priradené strany"

#: options/forms.py:56
msgid ""
"Draw strength pullups require 'Minimum cost matching (including pullups)' as"
" the conflict avoidance method"
msgstr ""
"Pullup podľa sily pairingu vyžaduje 'Párovania minimálnych nákladov (vrátane"
" pullupu)' ako metódu vyhýbania sa konfliktom"

#: options/forms.py:59
msgid ""
"Intermediate-type pullups require 'One-up-one-down' as the conflict "
"avoidance method"
msgstr ""
"Pullup medzikošového typu vyžaduje 'One-up-one-down' ako metódu vyhýbania sa"
" konfliktom"

#: options/forms.py:63
msgid "Four-team formats require consensus ballots"
msgstr "Formáty so štyrmi tímami vyžadujú konsenzuálne balloty"

#: options/forms.py:66
msgid "Solo speech format requires one team per debate."
msgstr "Formát sólovej reči vyžaduje jeden tím na debatu."

#: options/forms.py:67
msgid "Set this to 1 when using solo speech format."
msgstr "Nastav na 1 pri používaní formátu sólovej reči."

#: options/forms.py:71
msgid "Enable solo speech format when using one team per debate."
msgstr "Zapni formát sólovej reči pri použití jedného tímu na debatu."

#: options/forms.py:72
msgid "One-team debates are only supported in solo speech format."
msgstr "Debaty s jedným tímom sú podporované len vo formáte sólovej reči."

#: options/forms.py:83
msgid "Score step must be greater than 0."
msgstr "Krok skóre musí byť väčší ako 0."

#: options/forms.py:86
#, python-format
msgid ""
"Score step (%(step)s) cannot be greater than the maximum score (%(max)s)."
msgstr "Krok skóre (%(step)s) nemôže byť väčší ako maximálne skóre (%(max)s)."

#: options/forms.py:91
msgid "Must set a password if using a password is enabled"
msgstr "Ak je vyžadované heslo, musíš ho nastaviť"

#: options/forms.py:95
msgid "Showing team institutions defeats the purpose of code names"
msgstr "Zobrazovanie inštitúcií tímov popiera zmysel kódových názvov"

#: options/models.py:13
msgid "instance"
msgstr "inštancia"

#: options/models.py:18
msgid "tournament preference"
msgstr "nastavenie turnaja"

#: options/models.py:19
msgid "tournament preferences"
msgstr "nastavenia turnaja"

#: options/preferences.py:20 options/templates/preferences_index.html:15
msgid "Score Rules"
msgstr "Pravidlá bodov"

#: options/preferences.py:26
msgid "Minimum allowed score for substantive speeches"
msgstr "Minimálne povolené skóre pre substantívne reči"

#: options/preferences.py:29
msgid "Minimum speaker score"
msgstr "Minimálne skóre rečníka/rečníčky"

#: options/preferences.py:35
msgid "Maximum speaker score"
msgstr "Maximálne skóre rečníka/rečníčky"

#: options/preferences.py:36
msgid "Maximum allowed score for substantive speeches"
msgstr "Maximálne povolené skóre pre substantívne reči"

#: options/preferences.py:44
msgid "Speaker score step"
msgstr "Krok skóre rečníka/rečníčky"

#: options/preferences.py:45
msgid ""
"Score steps allowed for substantive speeches, e.g. full points (1) or half "
"points (0.5)"
msgstr ""
"Povolené kroky skóre pre substantívne reči, napr. celé body (1) alebo "
"polovičné body (0.5)"

#: options/preferences.py:53
msgid ""
"The largest amount by which one team can beat another (0 means no limit)"
msgstr ""
"Maximálny rozdiel bodov, o ktorý môže jeden tím poraziť druhý (0 znamená bez"
" obmedzenia)"

#: options/preferences.py:54
msgid "Maximum margin"
msgstr "Maximálny rozdiel"

#: options/preferences.py:63
msgid "Minimum allowed score for reply speeches"
msgstr "Minimálne povolené skóre pre záverečné reči"

#: options/preferences.py:64
msgid "Minimum reply score"
msgstr "Minimálne skóre záverečnej reči"

#: options/preferences.py:72
msgid "Maximum allowed score for reply speeches"
msgstr "Maximálne povolené skóre pre záverečné reči"

#: options/preferences.py:73
msgid "Maximum reply score"
msgstr "Maximálne skóre záverečnej reči"

#: options/preferences.py:81
msgid ""
"Score steps allowed for reply speeches, e.g. full points (1) or half points "
"(0.5)"
msgstr ""
"Povolené kroky skóre pre záverečné reči, napr. celé body (1) alebo polovičné"
" body (0.5)"

#: options/preferences.py:82
msgid "Reply score step"
msgstr "Krok skóre záverečnej reči"

#: options/preferences.py:90
msgid ""
"Minimum allowed score for cross-examinations when using a single cross total"
msgstr ""
"Minimálne povolené skóre pre krížové výsluchy pri použití jediného celkového"
" súčtu"

#: options/preferences.py:91
msgid "Minimum cross-examination score"
msgstr "Minimálne skóre krížového výsluchu"

#: options/preferences.py:99
msgid ""
"Maximum allowed score for cross-examinations when using a single cross total"
msgstr ""
"Maximálne povolené skóre pre krížové výsluchy pri použití jediného celkového"
" súčtu"

#: options/preferences.py:100
msgid "Maximum cross-examination score"
msgstr "Maximálne skóre krížového výsluchu"

#: options/preferences.py:108
msgid ""
"Score steps allowed for cross-examinations when using a single cross total, "
"e.g. full points (1) or half points (0.5)"
msgstr ""
"Povolené kroky skóre pre krížové výsluchy pri použití jediného celkového "
"súčtu, napr. celé body (1) alebo polovičné body (0.5)"

#: options/preferences.py:109
msgid "Cross-examination score step"
msgstr "Krok skóre krížového výsluchu"

#: options/preferences.py:116
msgid "If checked, a team's winning margin includes dissenting adjudicators"
msgstr ""
"Ak je zaškrtnuté, rozdiel víťazného tímu zahŕňa aj nesúhlasiacich "
"rozhodcov/rozhodkyne"

#: options/preferences.py:117
msgid "Margin includes dissenters"
msgstr "Rozdiel zahŕňa nesúhlasiacich"

#: options/preferences.py:125
msgid ""
"How is the speaker's score from a debate judged by multiple judges "
"calculated: Mean (default), or Median (required by Karl Popper rules)."
msgstr ""
"Ako sa vypočítajú body rečníka v debate hodnotenej viacerými rozhodcami: "
"priemer (predvolené) alebo medián (vyžadovaný pravidlami formátu Karl "
"Popper)."

#: options/preferences.py:127
msgid "Panel score aggregation function"
msgstr "Spôsob výpočtu bodov z hodnotení rozhodcov"

#: options/preferences.py:131
msgid "Mean (average)"
msgstr "Aritmetický priemer"

#: options/preferences.py:132
msgid "Median (in even-numbered panels, decimals rounded up)"
msgstr "Medián (pri párnom počte rozhodcov sa priemer zaokrúhli nahor)"

#: options/preferences.py:139
msgid ""
"Any explanatory text needed to introduce the ballot form, e.g. speaker scale"
msgstr ""
"Akýkoľvek vysvetľujúci text k formuláru ballotu, napr. bodovacia škála"

#: options/preferences.py:140
msgid "Ballot introduction/explanation"
msgstr "Úvod/vysvetlenie ballotu"

#: options/preferences.py:150
msgid ""
"If checked, all speaker scores, including for duplicate speeches, will be "
"counted for team scores"
msgstr ""
"Ak je zaškrtnuté, všetky rečnícke body vrátane duplicitných rečí sa zarátajú"
" do tímového skóre"

#: options/preferences.py:151
msgid "Team score includes ghosts"
msgstr "Tímové skóre zahŕňa duplikáty"

#: options/preferences.py:158 options/templates/preferences_index.html:20
msgid "Draw Rules"
msgstr "Pravidlá pairingu"

#: options/preferences.py:164
msgid ""
"The auto-allocator will only take adjudicators at or above this score as "
"voting panellists"
msgstr ""
"Automatický prideľovač bude brať ako hlasujúcich panelistov len "
"rozhodcov/rozhodkyne s týmto skóre alebo vyšším"

#: options/preferences.py:165
msgid "Minimum adjudicator score to vote"
msgstr "Minimálne skóre rozhodcu/rozhodkyne na hlasovanie"

#: options/preferences.py:173
msgid "Penalty applied by adjudicator auto-allocator for conflicts"
msgstr ""
"Penalizácia automatického prideľovača rozhodcov/rozhodkýň za konflikty"

#: options/preferences.py:174
msgid "Adjudicator conflict penalty"
msgstr "Penalizácia za konflikt rozhodcu/rozhodkyne"

#: options/preferences.py:182
msgid "Penalty applied by adjudicator auto-allocator for history"
msgstr "Penalizácia automatického prideľovača rozhodcov/rozhodkýň za históriu"

#: options/preferences.py:183
msgid "Adjudicator history penalty"
msgstr "Penalizácia za históriu rozhodcu/rozhodkyne"

#: options/preferences.py:191
msgid ""
"Penality applied by preformed panel auto-allocator for priority mismatch"
msgstr ""
"Penalizácia automatického prideľovača predpripravených panelov za nesúlad "
"priorít"

#: options/preferences.py:192
msgid "Importance mismatch penalty"
msgstr "Penalizácia za nesúlad dôležitosti"

#: options/preferences.py:200
msgid ""
"Penalty applied by conflict avoidance method for teams seeing their own "
"institution"
msgstr ""
"Penalizácia metódy vyhýbania sa konfliktom za stretnutie tímov z rovnakej "
"inštitúcie"

#: options/preferences.py:201
msgid "Team institution penalty"
msgstr "Penalizácia za inštitúciu tímu"

#: options/preferences.py:209
msgid ""
"Penalty applied by conflict avoidance method for teams seeing each other "
"twice or more"
msgstr ""
"Penalizácia metódy vyhýbania sa konfliktom za opakované stretnutia tímov"

#: options/preferences.py:210
msgid "Team history penalty"
msgstr "Penalizácia za históriu tímu"

#: options/preferences.py:218
msgid ""
"If checked, the draw will try to avoid pairing teams against their own "
"institution"
msgstr ""
"Ak je zaškrtnuté, pairing sa pokúsi vyhnúť stretnutiu tímov z rovnakej "
"inštitúcie"

#: options/preferences.py:219
msgid "Avoid same institution"
msgstr "Vyhýbať sa rovnakej inštitúcii"

#: options/preferences.py:227
msgid ""
"If checked, the draw will try to avoid having teams see each other twice"
msgstr ""
"Ak je zaškrtnuté, pairing sa pokúsi vyhnúť opakovanému stretnutiu tímov"

#: options/preferences.py:228
msgid "Avoid team history"
msgstr "Vyhýbať sa histórii tímu"

#: options/preferences.py:236
msgid ""
"Penalty applied by conflict avoidance method for teams being in a pullup "
"many times. Leave 0 for no penalty."
msgstr ""
"Penalizácia metódy vyhýbania sa konfliktom za opakované pullup tímov. Nechaj"
" 0 pre žiadnu penalizáciu."

#: options/preferences.py:237
msgid "Previously saw pullup penalty"
msgstr "Penalizácia za predchádzajúci pullup"

#: options/preferences.py:245
msgid ""
"Penalty applied by minimum cost matching to prefer pairings that balance "
"sides."
msgstr ""
"Penalizácia párovacieho algoritmu minimálnych nákladov na uprednostnenie "
"pairingov, ktoré vyvážia strany."

#: options/preferences.py:246
msgid "Side balance penalty"
msgstr "Penalizácia za nevyváženie strán"

#: options/preferences.py:254
msgid ""
"Penalty applied by minimum cost matching to prefer pairings that follow the "
"draw pairing method."
msgstr ""
"Penalizácia párovacieho algoritmu minimálnych nákladov na uprednostnenie "
"pairingov zodpovedajúcich metóde pairingu."

#: options/preferences.py:255
msgid "Pairing deviation penalty"
msgstr "Penalizácia za odchýlku pairingu"

#: options/preferences.py:263
msgid ""
"Hard preference applied by minimum cost matching to disallow pairings where "
"a team would debate                   more than this many times on the same "
"side. WARNING: if you set this to a low value, the draw                   "
"algorithm may be unable to find a valid draw."
msgstr ""
"Pevné obmedzenie párovacieho algoritmu minimálnych nákladov zakazujúce "
"pairingy, pri ktorých by tím debatoval viac ako toľkokrát na rovnakej "
"strane. POZOR: ak nastavíš nízku hodnotu, algoritmus pairingu nemusí byť "
"schopný nájsť platný pairing."

#: options/preferences.py:266
msgid "Maximum number of times per side"
msgstr "Maximálny počet opakovaní na jednej strane"

#: options/preferences.py:274
msgid ""
"When greater than 1, consecutive preliminary rounds are treated as parallel "
"panels in the same schedule slot (e.g. A and B). Current-round navigation "
"and feedback eligibility use the shared slot. Round creation assigns "
"schedule groups from this value."
msgstr ""
"Pri hodnote väčšej ako 1 sa po sebe idúce základné kolá považujú za súbežné "
"panely v rovnakom časovom bloku (napr. A a B). Navigácia aktuálneho kola a "
"oprávnenie odovzdať spätnú väzbu používajú spoločný blok. Pri vytváraní kôl "
"sa podľa tejto hodnoty priraďujú skupiny rozvrhu."

#: options/preferences.py:277
msgid "Preliminary panels per schedule slot"
msgstr "Počet základných panelov v časovom bloku"

#: options/preferences.py:286
msgid "How odd brackets are resolved (see documentation for further details)"
msgstr "Ako sa riešia nepárne koše (ďalšie podrobnosti nájdeš v dokumentácii)"

#: options/preferences.py:287
msgid "Odd bracket resolution method"
msgstr "Metóda riešenia nepárnych košov"

#: options/preferences.py:291
msgid "Pull up from top"
msgstr "Pullup zhora"

#: options/preferences.py:292
msgid "Pull up from bottom"
msgstr "Pullup zdola"

#: options/preferences.py:293
msgid "Pull up from middle"
msgstr "Pullup zo stredu"

#: options/preferences.py:294
msgid "Pull up at random"
msgstr "Náhodný pullup"

#: options/preferences.py:295
msgid "Intermediate brackets"
msgstr "Medzikošové párovania"

#: options/preferences.py:296
msgid "Intermediate brackets with bubble-up-bubble-down"
msgstr "Medzikošové párovania s bubble-up-bubble-down"

#: options/preferences.py:297
msgid "Intermediate 1 (pre-allocated sides)"
msgstr "Intermediate 1 (vopred priradené strany)"

#: options/preferences.py:298
msgid "Intermediate 2 (pre-allocated sides)"
msgstr "Intermediate 2 (vopred priradené strany)"

#: options/preferences.py:299
msgid "Pull up from the lowest draw strength by rank"
msgstr "Pullup tímu s najnižšou silou pairingu podľa poradia"

#: options/preferences.py:300
msgid ""
"Pull up from the least pulled up, then the lowest draw strength by rank"
msgstr ""
"Pullup tímu, ktorý bol pullupnutý najmenej, potom podľa najnižšej sily "
"pairingu"

#: options/preferences.py:307
msgid ""
"How affirmative/negative positions are assigned (see documentation for "
"further details)"
msgstr ""
"Ako sa prideľujú pozície kladnej/zápornej strany (ďalšie podrobnosti nájdeš "
"v dokumentácii)"

#: options/preferences.py:308
msgid "Side allocations method"
msgstr "Metóda prideľovania strán"

#: options/preferences.py:312 options/preferences.py:329
msgid "Random"
msgstr "Náhodne"

#: options/preferences.py:313
msgid "Balance"
msgstr "Vyvažovanie"

#: options/preferences.py:314
msgid "Pre-allocated"
msgstr "Vopred priradené"

#: options/preferences.py:315
msgid "Manually enter from ballot"
msgstr "Ručne zadať z ballotu"

#: options/preferences.py:322
msgid ""
"Slide: 1 vs 6, 2 vs 7, …. Fold: 1 vs 10, 2 vs 9, …. Adjacent: 1 vs 2, 3 vs "
"4, …."
msgstr ""
"Slide: 1 vs 6, 2 vs 7, …. Fold: 1 vs 10, 2 vs 9, …. Adjacent: 1 vs 2, 3 vs "
"4, …."

#: options/preferences.py:323
msgid "Pairing method"
msgstr "Metóda pairingu"

#: options/preferences.py:327
msgid "Slide"
msgstr "Slide"

#: options/preferences.py:328
msgid "Fold"
msgstr "Fold"

#: options/preferences.py:330
msgid "Adjacent"
msgstr "Adjacent"

#: options/preferences.py:331
msgid "Fold top, adjacent rest"
msgstr "Fold top, adjacent zvyšok"

#: options/preferences.py:338
msgid ""
"Method used to try to avoid teams facing each other multiple times or their "
"own institution (see documentation for further details)"
msgstr ""
"Metóda na vyhýbanie sa opakovaným stretnutiam tímov alebo stretnutiam s "
"vlastnou inštitúciou (ďalšie podrobnosti nájdeš v dokumentácii)"

#: options/preferences.py:340
msgid "Conflict avoidance method"
msgstr "Metóda vyhýbania sa konfliktom"

#: options/preferences.py:344 options/preferences.py:1182
msgid "Off"
msgstr "Vypnuté"

#: options/preferences.py:345
msgid "One-up-one-down"
msgstr "One-up-one-down"

#: options/preferences.py:346
msgid "Minimum cost matching (pullups determined beforehand)"
msgstr "Párovania minimálnych nákladov (pullup určený vopred)"

#: options/preferences.py:347
msgid "Minimum cost matching (including pullups)"
msgstr "Párovania minimálnych nákladov (vrátane pullupu)"

#: options/preferences.py:354
msgid ""
"If using pull-ups, restrict which teams can be pulled up. Two-team formats "
"only. Has no effect on BP or intermediate brackets."
msgstr ""
"Ak sa používajú pullup tímy, obmedz, ktoré tímy môžu byť pullupnuté. Len pre"
" formáty s dvoma tímami. Nemá účinok na BP ani medzikošové párovania."

#: options/preferences.py:356
msgid "Pullup restriction"
msgstr "Obmedzenie pullupu"

#: options/preferences.py:360
msgid "No restriction"
msgstr "Bez obmedzenia"

#: options/preferences.py:361
msgid "Choose from teams who have been pulled up the fewest times so far"
msgstr "Vybrať z tímov, ktoré boli doteraz pullupnuté najmenej"

#: options/preferences.py:362
msgid "Choose from teams with the lowest draw strength by wins so far"
msgstr "Vybrať z tímov s najnižšou silou pairingu podľa výhier"

#: options/preferences.py:363
msgid "Choose from teams with the lowest draw strength by speaks so far"
msgstr "Vybrať z tímov s najnižšou silou pairingu podľa rečníckych bodov"

#: options/preferences.py:370
msgid ""
"Penalty applied when determining which teams to pull up (for minimum cost "
"matching). In BP, added to position costs when a team is placed above its "
"points bracket; teams with fewer prior pull-ups are preferred. Set high "
"enough to take precedence over side balance (e.g. 100000 with the default "
"position cost exponent). Leave 0 for no preference."
msgstr ""
"Penalizácia pri výbere tímov na presun do vyššej bodovej skupiny pri "
"párovaní s minimálnymi nákladmi. V BP sa pripočíta k nákladom pozície, ak "
"tím hrá nad svojou bodovou skupinou; uprednostnia sa tímy s menším počtom "
"predchádzajúcich presunov. Nastavte dostatočne vysokú hodnotu, ak má mať "
"prednosť pred vyvážením strán (napr. 100000 pri predvolenom exponente "
"nákladov pozície). Hodnota 0 znamená bez preferencie."

#: options/preferences.py:374
msgid "Pullup penalty"
msgstr "Penalizácia za pullup"

#: options/preferences.py:382
msgid "In BP, how pullups are distributed. Only \"Anywhere\" is WUDC-compliant."
msgstr ""
"V BP, ako sa pullup tímy rozdeľujú. Len 'Kdekoľvek' je v súlade s pravidlami"
" WUDC."

#: options/preferences.py:383
msgid "BP pullup distribution"
msgstr "Rozdelenie pullupu v BP"

#: options/preferences.py:387
msgid "Anywhere in bracket"
msgstr "Kdekoľvek v koši"

#: options/preferences.py:388
msgid "All in the same room (not WUDC-compliant)"
msgstr "Všetci v rovnakej miestnosti (nie je v súlade s WUDC)"

#: options/preferences.py:395
msgid ""
"In BP, which position cost function to use (see documentation for details)"
msgstr ""
"V BP, ktorú funkciu nákladov na pozíciu použiť (podrobnosti nájdeš v "
"dokumentácii)"

#: options/preferences.py:396
msgid "BP position cost"
msgstr "Náklady na pozíciu v BP"

#: options/preferences.py:400
msgid "Simple"
msgstr "Jednoduchý"

#: options/preferences.py:401
msgid "Rényi entropy"
msgstr "Rényiho entropia"

#: options/preferences.py:402
msgid "Population variance"
msgstr "Rozptyl populácie"

#: options/preferences.py:409
msgid ""
"Rényi order α, if BP position cost uses Rényi entropy. Shannon is α = 1, "
"Hartley is α = 0, collision is α = 2. See documentation for details."
msgstr ""
"Rényiho rád α, ak náklady na pozíciu v BP používajú Rényiho entropiu. "
"Shannon je α = 1, Hartley je α = 0, kolízia je α = 2. Podrobnosti nájdeš v "
"dokumentácii."

#: options/preferences.py:412
msgid "Rényi order (BP)"
msgstr "Rényiho rád (BP)"

#: options/preferences.py:421
msgid ""
"The BP position cost is raised to this power; higher exponents bias towards "
"resolving fewer large position imbalances over more small ones. See "
"documentation for details."
msgstr ""
"Náklady na pozíciu v BP sa umocnia na túto hodnotu; vyššie exponenty "
"uprednostňujú riešenie menšieho počtu väčších nerovnováh pozícií pred väčším"
" počtom menších. Podrobnosti nájdeš v dokumentácii."

#: options/preferences.py:424
msgid "BP position cost exponent"
msgstr "Exponent nákladov na pozíciu v BP"

#: options/preferences.py:433
msgid ""
"In BP, which method to use to solve the assignment problem. Only Hungarian "
"with preshuffling is WUDC-compliant."
msgstr ""
"V BP, ktorú metódu použiť na riešenie problému priradenia. Len maďarský "
"algoritmus s predsortovaním je v súlade s WUDC."

#: options/preferences.py:435
msgid "BP assignment method"
msgstr "Metóda priradenia v BP"

#: options/preferences.py:439
msgid "Hungarian algorithm (not WUDC-compliant)"
msgstr "Maďarský algoritmus (nie je v súlade s WUDC)"

#: options/preferences.py:440
msgid "Hungarian algorithm with preshuffling"
msgstr "Maďarský algoritmus s predsortovaním"

#: options/preferences.py:447
msgid "Automatically make all adjudicators available for all rounds"
msgstr "Automaticky sprístupniť všetkých rozhodcov/rozhodkyne pre všetky kolá"

#: options/preferences.py:448
msgid "Skip adjudicator check-ins"
msgstr "Preskočiť registráciu rozhodcov/rozhodkýň"

#: options/preferences.py:456
msgid "Hide panellist positions in the UI (and don't allocate them)"
msgstr "Skryť pozície panelistov v rozhraní (a nepridzovať ich)"

#: options/preferences.py:457
msgid "No panellist adjudicators"
msgstr "Žiadni panelisti"

#: options/preferences.py:465
msgid "Hide trainee positions in the UI (and don't allocate them)"
msgstr "Skryť pozície shadowov v rozhraní (a nepridzovať ich)"

#: options/preferences.py:466
msgid "No trainee adjudicators"
msgstr "Žiadni shadows"

#: options/preferences.py:474
msgid ""
"How to handle teams who were marked available yet excluded froma round (a "
"bye)"
msgstr ""
"Ako nakladať s tímami, ktoré boli označené ako dostupné, ale vynechané z "
"kola (bye)"

#: options/preferences.py:476
msgid "Bye team results"
msgstr "Výsledky tímov s bye"

#: options/preferences.py:480
msgid "Treat bye teams as absent"
msgstr "Zaobchádzať s bye tímami ako s neprítomné"

#: options/preferences.py:481
msgid "Attribute a win to bye teams, without speaks"
msgstr "Priradiť bye tímom výhru bez rečníckych bodov"

#: options/preferences.py:482
msgid "Attribute a win, ballots and running average scores to bye teams"
msgstr "Priradiť bye tímom výhru, balloty a priebežné priemerné body"

#: options/preferences.py:489
msgid ""
"If creating a draw with an uneven number of teams, how to decide who gets "
"the bye (won't be allocated)"
msgstr ""
"Ak je pairing vytváraný pre nepárny počet tímov, ako rozhodnúť, ktorý tím "
"dostane bye (nebude zaradený do pairingu)"

#: options/preferences.py:491
msgid "Bye team selection method"
msgstr "Metóda výberu tímu pre bye"

#: options/preferences.py:495
msgid "Don't choose bye teams"
msgstr "Nevyberať tímy pre bye"

#: options/preferences.py:496
msgid "Choose bye teams randomly"
msgstr "Vybrať tímy pre bye náhodne"

#: options/preferences.py:497
msgid "Choose lowest ranking teams"
msgstr "Vybrať tímy s najnižším poradím"

#: options/preferences.py:498
msgid "Choose the unmatched team in the final odd bracket"
msgstr "Vybrať nepárovaný tím v poslednom nepárnom koši"

#: options/preferences.py:505
msgid ""
"A limit for the side imbalance, where a pairing will not be made if that "
"requires a team to debate more times on one side than the selected number. "
"For use with the graph generator, with 0 as disabled."
msgstr ""
"Limit pre nevyváženie strán — pairing nebude vytvorený, ak by si tím "
"vyžadoval debatovaťna jednej strane viac ako tento počet krát. Určené pre "
"generátor grafov, 0 znamená vypnuté."

#: options/preferences.py:507
msgid "Maximum allowed side imbalance"
msgstr "Maximálne povolené nevyváženie strán"

#: options/preferences.py:515 options/templates/preferences_index.html:35
msgid "Feedback"
msgstr "Spätná väzba"

#: options/preferences.py:521
msgid "Minimum possible adjudicator score that can be given"
msgstr "Minimálne možné skóre rozhodcu/rozhodkyne"

#: options/preferences.py:522
msgid "Minimum adjudicator score"
msgstr "Minimálne skóre rozhodcu/rozhodkyne"

#: options/preferences.py:530
msgid "Maximum possible adjudicator score that can be given"
msgstr "Maximálne možné skóre rozhodcu/rozhodkyne"

#: options/preferences.py:531
msgid "Maximum adjudicator score"
msgstr "Maximálne skóre rozhodcu/rozhodkyne"

#: options/preferences.py:539
msgid ""
"Score step allowed when entering adjudicator feedback scores, e.g. full "
"points (1) or half points (0.5)"
msgstr ""
"Povolený krok skóre pri zadávaní hodnotení rozhodcov/rozhodkýň zo spätnej "
"väzby, napr. celé body (1) alebo polovičné body (0.5)"

#: options/preferences.py:540
msgid "Adjudicator score step"
msgstr "Krok skóre rozhodcu/rozhodkyne"

#: options/preferences.py:548
msgid ""
"Used to inform available choices in the feedback forms for adjudicators "
"(both online and printed) and feedback progress"
msgstr ""
"Určuje dostupné možnosti vo formulároch spätnej väzby pre "
"rozhodcov/rozhodkyne (online aj tlačené) a sledovanie pokroku spätnej väzby"

#: options/preferences.py:549
msgid "Allow and expect feedback to be submitted by"
msgstr "Povoliť a očakávať odoslanie spätnej väzby od"

#: options/preferences.py:553
msgid "Chairs on panellists and trainees"
msgstr "Chair na panelistov a shadowov"

#: options/preferences.py:554
msgid "Panellists on chairs, chairs on panellists and trainees"
msgstr "Panelisti na chairov, chair na panelistov a shadowov"

#: options/preferences.py:555
msgid "Panellists and trainees on chairs, chairs on panellists and trainees"
msgstr "Panelisti a shadows na chairov, chair na panelistov a shadowov"

#: options/preferences.py:556
msgid "All adjudicators (including trainees) on each other"
msgstr "Všetci rozhodcovia/rozhodkyne (vrátane shadowov) navzájom"

#: options/preferences.py:557
msgid ""
"Panellists on eachother and chairs, trainees on chairs, chairs on everyone"
msgstr ""
"Panelisti navzájom a na chairov, shadows na chairov, chair na všetkých"

#: options/preferences.py:558
msgid "Neither chairs, nor panellists nor trainees"
msgstr "Ani chair, ani panelisti, ani shadows"

#: options/preferences.py:565
msgid "Allow and expect feedback to be submitted by teams on"
msgstr "Povoliť a očakávať spätnú väzbu tímov na"

#: options/preferences.py:566
msgid ""
"Used to inform available choices in the feedback forms for teams (both "
"online and printed) and feedback progress; this option is used by, e.g., "
"UADC"
msgstr ""
"Určuje dostupné možnosti vo formulároch spätnej väzby pre tímy (online aj "
"tlačené) a sledovanie pokroku; túto možnosť používa napr. UADC"

#: options/preferences.py:570
msgid ""
"Orallist only (voting panellists permitted, with prompts to select orallist)"
msgstr ""
"Len oralista (hlasujúci panelisti povolení, s výzvou na výber oralistu)"

#: options/preferences.py:571
msgid "Allow all voting adjudicators, but only expect the orallist"
msgstr ""
"Povoliť všetkých hlasujúcich rozhodcov, ale očakávať iba vyhlasujúceho "
"rozhodcu"

#: options/preferences.py:572
msgid ""
"Allow all adjudicators (including trainees), but only expect the orallist"
msgstr ""
"Povoliť všetkých rozhodcov (vrátane tieňových), ale očakávať iba "
"vyhlasujúceho rozhodcu"

#: options/preferences.py:573
msgid "All voting adjudicators (excluding trainees)"
msgstr "Všetkých hlasujúcich rozhodcov (bez tieňových)"

#: options/preferences.py:574
msgid "All adjudicators (including trainees)"
msgstr "Všetkých rozhodcov (vrátane tieňových)"

#: options/preferences.py:575
msgid "No one"
msgstr "Nikto"

#: options/preferences.py:582
msgid "Show unexpected feedback submissions in participants pages"
msgstr "Zobraziť neočakávané odoslania spätnej väzby na stránkach účastníkov"

#: options/preferences.py:583
msgid ""
"Displays unexpected feedback with a question mark symbol; only relevant if "
"public participants and feedback progress are both enabled"
msgstr ""
"Zobrazuje neočakávanú spätnú väzbu so symbolom otáznika; relevantné len ak "
"sú zapnutí verejní účastníci aj sledovanie pokroku spätnej väzby"

#: options/preferences.py:591
msgid "Show if an adjudicator is a trainee (unaccredited)"
msgstr "Zobraziť, či je rozhodca/rozhodkyňa shadow (neakreditovaný/-á)"

#: options/preferences.py:592
msgid "Show unaccredited"
msgstr "Zobraziť neakreditovaných"

#: options/preferences.py:600
msgid "Any explanatory text needed to introduce the feedback form"
msgstr "Akýkoľvek vysvetľujúci text k formuláru spätnej väzby"

#: options/preferences.py:601
msgid "Feedback introduction/explanation"
msgstr "Úvod/vysvetlenie spätnej väzby"

#: options/preferences.py:611
msgid ""
"If enabled, feedback forms ask for an overall adjudicator score and "
"confirmed feedback ratings are included in adjudicator score calculations. "
"If disabled, feedback can still be submitted but will not affect adjudicator"
" scores."
msgstr ""
"Ak je zapnuté, formuláre spätnej väzby sa pýtajú na celkové skóre "
"rozhodcu/rozhodkyne a potvrdené hodnotenia zo spätnej väzby sa započítavajú "
"do výpočtu skóre rozhodcov/rozhodkýň. Ak je vypnuté, spätná väzba sa stále "
"dá odosielať, ale neovplyvní skóre rozhodcov/rozhodkýň."

#: options/preferences.py:612
msgid "Feedback affects adjudicator scores"
msgstr "Spätná väzba ovplyvňuje skóre rozhodcov/rozhodkýň"

#: options/preferences.py:619 options/templates/preferences_index.html:25
msgid "Debate Rules"
msgstr "Pravidlá debaty"

#: options/preferences.py:625
msgid "How many teams are in each debate (normally 2 but 4 for BP)"
msgstr "Počet tímov v každej debate (zvyčajne 2, pre BP 4)"

#: options/preferences.py:626
msgid "Number of teams per debate"
msgstr "Počet tímov na debatu"

#: options/preferences.py:634
msgid ""
"Use one team with one speaker per debate, with no opponent but with an "
"assigned affirmative/negative side"
msgstr ""
"Použiť jeden tím s jedným rečníkom/rečníčkou na debatu bez súpera, ale s "
"pridelenou kladnou/zápornou stranou"

#: options/preferences.py:635
msgid "Solo speech format"
msgstr "Formát sólovej reči"

#: options/preferences.py:643
msgid ""
"Whether panels submit a ballot each or a single ballot for a debate during "
"the preliminary rounds. Note: BP must use one per debate."
msgstr ""
"Či panely odovzdávajú každý vlastný ballot alebo jeden spoločný ballot na "
"debatu počas predkôl. Poznámka: BP musí používať jeden ballot na debatu."

#: options/preferences.py:644
msgid "Ballots per debate, preliminary rounds"
msgstr "Balloty na debatu, predkolá"

#: options/preferences.py:648 options/preferences.py:661
msgid "One ballot per voting adjudicator"
msgstr "Jeden ballot na každého hlasujúceho rozhodcu/rozhodkyňu"

#: options/preferences.py:649 options/preferences.py:662
msgid "Consensus ballot (one ballot per debate)"
msgstr "Konsenzuálny ballot (jeden ballot na debatu)"

#: options/preferences.py:656
msgid ""
"Whether panels submit a ballot each or a single ballot for a debate during "
"the elimination rounds. Note: BP must use one per debate."
msgstr ""
"Či panely odovzdávajú každý vlastný ballot alebo jeden spoločný ballot na "
"debatu počas vyraďovacích kôl. Poznámka: BP musí používať jeden ballot na "
"debatu."

#: options/preferences.py:657
msgid "Ballots per debate, elimination rounds"
msgstr "Balloty na debatu, vyraďovacie kolá"

#: options/preferences.py:669
msgid ""
"How adjudicator votes and aggregated scores are weighted in per-adjudicator "
"ballots."
msgstr ""
"Ako sa váhujú hlasy rozhodcov/rozhodkýň a súhrnné body v ballotoch na "
"rozhodcu/rozhodkyňu."

#: options/preferences.py:670
msgid "Adjudicator weighting"
msgstr "Váhovanie rozhodcov/rozhodkýň"

#: options/preferences.py:674
msgid "Tabbycat default"
msgstr "Predvolené nastavenie Tabbycat"

#: options/preferences.py:675
msgid "Weighted to three votes"
msgstr "Váhovanie na tri hlasy"

#: options/preferences.py:682
msgid ""
"Whether adjudicator(s) must select the winning team in their ballot, and how"
" it should be treated. Note: Not supported in BP."
msgstr ""
"Či rozhodca/rozhodkyne musí/musia vybrať víťazný tím vo svojom ballote a ako"
" sa to má spracovať. Poznámka: V BP nie je podporované."

#: options/preferences.py:683
msgid "Winner Declaration in ballot(s)"
msgstr "Vyhlásenie víťaza v ballot(och)"

#: options/preferences.py:687
msgid "Do not require separate winner selection"
msgstr "Nevyžadovať samostatný výber víťaza"

#: options/preferences.py:688
msgid "Require separate winner selection as a check on correct scores"
msgstr "Vyžadovať samostatný výber víťaza ako kontrolu správnosti bodov"

#: options/preferences.py:689
msgid "Require winner selection to break tied-point debates"
msgstr "Vyžadovať výber víťaza na rozhodnutie debát s rovnakým počtom bodov"

#: options/preferences.py:690
msgid "Require winner selection, overriding scores"
msgstr "Vyžadovať výber víťaza s prednosťou pred bodmi"

#: options/preferences.py:697
msgid "When ballots should ask for speaker scores."
msgstr "Kedy majú balloty vyžadovať rečnícke body."

#: options/preferences.py:698
msgid "Require speaker scores"
msgstr "Vyžadovať rečnícke body"

#: options/preferences.py:702
msgid "Always require speaker scores"
msgstr "Vždy vyžadovať rečnícke body"

#: options/preferences.py:703
msgid "Only require speaker scores in preliminary rounds"
msgstr "Vyžadovať rečnícke body len v predkolách"

#: options/preferences.py:704
msgid "Never require speaker scores"
msgstr "Nikdy nevyžadovať rečnícke body"

#: options/preferences.py:711
msgid "How many substantive speakers on a team"
msgstr "Počet substantívnych rečníkov/rečníčok v tíme"

#: options/preferences.py:712
msgid "Substantive speakers"
msgstr "Substantívni rečníci/rečníčky"

#: options/preferences.py:720
msgid "What to call the teams"
msgstr "Ako pomenovať strany"

#: options/preferences.py:721
msgid "Side names"
msgstr "Názvy strán"

#: options/preferences.py:730
msgid "Whether this style features scored reply speeches"
msgstr "Či tento formát zahŕňa bodované záverečné reči"

#: options/preferences.py:731
msgid "Reply scores"
msgstr "Body záverečných rečí"

#: options/preferences.py:740
msgid ""
"Whether this style includes scored cross-examinations that contribute to "
"team totals"
msgstr ""
"Či tento formát zahŕňa bodované krížové výsluchy, ktoré sa zarátavajú do "
"tímových súčtov"

#: options/preferences.py:741
msgid "Cross-examination scores"
msgstr "Body krížového výsluchu"

#: options/preferences.py:748
msgid ""
"Whether to limit reply speeches to speakers who gave a substantive speech in"
" the debate"
msgstr ""
"Či obmedziť záverečné reči len na rečníkov/rečníčky, ktorí/é predniesli "
"substantívnu reč v debate"

#: options/preferences.py:749
msgid "Require reply speaker to have given a substantive speech"
msgstr ""
"Vyžadovať, aby rečník/rečníčka záverečnej reči predniesol/preniesla "
"substantívnu reč"

#: options/preferences.py:757
msgid "Whether and how to use speech ranks within a debate"
msgstr "Či a ako používať poradie rečí v rámci debaty"

#: options/preferences.py:758
msgid "Use of speech ranks"
msgstr "Používanie poradia rečí"

#: options/preferences.py:771
msgid ""
"How long, in minutes, after motion release does the round start (-1 to "
"deactivate)"
msgstr ""
"Ako dlho v minútach po zverejnení tézy začína kolo (-1 na deaktiváciu)"

#: options/preferences.py:772
msgid "Preparation Time"
msgstr "Čas na prípravu"

#: options/preferences.py:781
msgid ""
"Whether there should be an option in ballot forms to mark a team as having "
"forfeitted a round, rendering the debate win/loss without speaker scores"
msgstr ""
"Či majú balloty obsahovať možnosť označiť tím ako vzdávajúci kolo, čím sa "
"debata rozhodne bez rečníckych bodov"

#: options/preferences.py:783
msgid "Enable forfeits"
msgstr "Povoliť vzdanie kola"

#: options/preferences.py:790 options/templates/preferences_index.html:30
msgid "Standings"
msgstr "Poradie"

#: options/preferences.py:796
msgid ""
"The number of substantive speeches a speaker can miss and still be on the "
"speaker tab (-1 means no limit)"
msgstr ""
"Počet substantívnych rečí, ktoré rečník/rečníčka môže vynechať a stále byť v"
" poradí rečníkov (-1 znamená bez obmedzenia)"

#: options/preferences.py:797
msgid "Speeches missable for standings eligibility"
msgstr "Povolené vynechané reči pre zaradenie do poradia"

#: options/preferences.py:805
msgid ""
"The number of reply speeches a speaker can miss and still be on the replies "
"tab (-1 means no limit)"
msgstr ""
"Počet záverečných rečí, ktoré rečník/rečníčka môže vynechať a stále byť v "
"poradí záverečných rečí (-1 znamená bez obmedzenia)"

#: options/preferences.py:806
msgid "Replies missable for standings eligibility"
msgstr "Povolené vynechané záverečné reči pre zaradenie do poradia"

#: options/preferences.py:814
msgid "Metrics to use to rank teams (see documentation for further details)"
msgstr "Metriky na zoradenie tímov (ďalšie podrobnosti nájdeš v dokumentácii)"

#: options/preferences.py:815
msgid "Team standings precedence"
msgstr "Prednosť v poradí tímov"

#: options/preferences.py:830
msgid "Metrics to calculate, but not used to rank teams"
msgstr "Metriky na výpočet, ktoré sa však nepoužívajú na zoradenie tímov"

#: options/preferences.py:831
msgid "Team standings extra metrics"
msgstr "Doplnkové metriky poradia tímov"

#: options/preferences.py:842
msgid ""
"Metrics to use to rank speakers (see documentation for further details)"
msgstr ""
"Metriky na zoradenie rečníkov/rečníčok (ďalšie podrobnosti nájdeš v "
"dokumentácii)"

#: options/preferences.py:843
msgid "Speaker standings precedence"
msgstr "Prednosť v poradí rečníkov/rečníčok"

#: options/preferences.py:858
msgid "Metrics to calculate, but not used to rank speakers"
msgstr ""
"Metriky na výpočet, ktoré sa však nepoužívajú na zoradenie rečníkov/rečníčok"

#: options/preferences.py:859
msgid "Speaker standings extra metrics"
msgstr "Doplnkové metriky poradia rečníkov/rečníčok"

#: options/preferences.py:869 options/templates/preferences_index.html:56
msgid "Tab Release"
msgstr "Zverejnenie tabu"

#: options/preferences.py:875
msgid ""
"Enables public display of the team tab. Intended for use after the "
"tournament."
msgstr "Zapína verejné zobrazenie tímu tabu. Určené na použitie po turnaji."

#: options/preferences.py:876
msgid "Release team tab to public"
msgstr "Zverejniť tímový tab"

#: options/preferences.py:884
msgid ""
"Only show scores for the top X teams in the public tab (set to 0 to show all"
" teams)."
msgstr ""
"Zobraziť body len pre top X tímov vo verejnom tabe (nastav na 0 pre "
"zobrazenie všetkých tímov)."

#: options/preferences.py:885
msgid "Top teams cutoff"
msgstr "Obmedzenie na top tímy"

#: options/preferences.py:893
msgid ""
"Enables public display of the speaker tab. Intended for use after the "
"tournament."
msgstr ""
"Zapína verejné zobrazenie rečníckeho tabu. Určené na použitie po turnaji."

#: options/preferences.py:894
msgid "Release speaker tab to public"
msgstr "Zverejniť rečnícky tab"

#: options/preferences.py:902
msgid ""
"Only show scores for the top X speakers in the public tab (set to 0 to show "
"all speakers)."
msgstr ""
"Zobraziť body len pre top X rečníkov/rečníčok vo verejnom tabe (nastav na 0 "
"pre zobrazenie všetkých)."

#: options/preferences.py:903
msgid "Top speakers cutoff"
msgstr "Obmedzenie na top rečníkov/rečníčky"

#: options/preferences.py:911
msgid ""
"Enables public display of the replies tab. Intended for use after the "
"tournament."
msgstr ""
"Zapína verejné zobrazenie tabu záverečných rečí. Určené na použitie po "
"turnaji."

#: options/preferences.py:912
msgid "Release replies tab to public"
msgstr "Zverejniť tab záverečných rečí"

#: options/preferences.py:920
msgid ""
"Only show scores for the top X repliers in the public tab (set to 0 to show "
"all repliers)."
msgstr ""
"Zobraziť body len pre top X rečníkov/rečníčok záverečných rečí vo verejnom "
"tabe (nastav na 0 pre zobrazenie všetkých)."

#: options/preferences.py:921
msgid "Top replies cutoff"
msgstr "Obmedzenie na top záverečné reči"

#: options/preferences.py:947
msgid ""
"Enables public display of all motions and win/loss/selection information. "
"This includes all motions — whether they have been marked as released or "
"not. Intended for use after the tournament."
msgstr ""
"Zapína verejné zobrazenie všetkých téz a informácií o "
"výhrách/prehrách/výbere. Zahŕňa všetky tézy — bez ohľadu na to, či boli "
"označené ako zverejnené. Určené na použitie po turnaji."

#: options/preferences.py:950
msgid "Release motions tab to public"
msgstr "Zverejniť tab téz"

#: options/preferences.py:958
msgid "Enables public display of the feedback scores of all adjudicators"
msgstr ""
"Zapína verejné zobrazenie skóre spätnej väzby všetkých rozhodcov/rozhodkýň"

#: options/preferences.py:959
msgid "Release adjudicator tab to public"
msgstr "Zverejniť tab rozhodcov/rozhodkýň"

#: options/preferences.py:967
msgid "What (if released) the adjudicator tab shows"
msgstr "Čo zobrazuje tab rozhodcov/rozhodkýň (ak je zverejnený)"

#: options/preferences.py:968
msgid "Adjudicator tab displays"
msgstr "Zobrazenie tabu rozhodcov/rozhodkýň"

#: options/preferences.py:972
msgid "Only shows base score"
msgstr "Zobrazuje len základné skóre"

#: options/preferences.py:973
msgid "Only shows final score"
msgstr "Zobrazuje len finálne skóre"

#: options/preferences.py:974
msgid "Shows base, final, and per-round scores"
msgstr "Zobrazuje základné, finálne aj skóre za jednotlivé kolá"

#: options/preferences.py:981
msgid ""
"Enables public display of every adjudicator's ballot. Intended for use after"
" the tournament."
msgstr ""
"Zapína verejné zobrazenie ballotov každého rozhodcu/rozhodkyne. Určené na "
"použitie po turnaji."

#: options/preferences.py:982
msgid "Release ballots to public"
msgstr "Zverejniť balloty"

#: options/preferences.py:990
msgid ""
"This releases all the results for all rounds (including silent and break "
"rounds). Do so only after the tournament is finished!"
msgstr ""
"Toto zverejní všetky výsledky pre všetky kolá (vrátane tichých a postupových"
" kôl). Urob to len po skončení turnaja!"

#: options/preferences.py:991
