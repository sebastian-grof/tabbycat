msgid ""
"3 vs 3 with replies, chosen motions, and all adjudicators can receive "
"feedback from teams."
msgstr ""
"3 vs 3 so záverečnými rečami, vybranými tézami a všetci "
"rozhodcovia/rozhodkyne môžu dostávať spätnú väzbu od tímov."

#: options/presets.py:399
msgid "WSDC Rules"
msgstr "WSDC pravidlá"

