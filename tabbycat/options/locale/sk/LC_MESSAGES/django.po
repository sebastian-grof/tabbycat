#: options/presets.py:86
msgid "Australs Rules"
msgstr "Australs pravidlá"

#: options/presets.py:87
msgid "3 vs 3 with replies, chosen motions, intermediate brackets, one-up-one-down. Compliant with AIDA rules."
msgstr "3 vs 3 so záverečnými rečami, vybranými tézami, medzikošovými párovaniami, one-up-one-down. V súlade s pravidlami AIDA."

#: options/presets.py:126
msgid "British Parliamentary Rules"
msgstr "British Parliamentary pravidlá"

#: options/presets.py:127
msgid "2 vs 2 vs 2 vs 2. Compliant with WUDC rules."
msgstr "2 vs 2 vs 2 vs 2. V súlade s pravidlami WUDC."

#: options/presets.py:172
msgid "Canadian Parliamentary Rules"
msgstr "Canadian Parliamentary pravidlá"

#: options/presets.py:174
msgid "2 vs 2 with replies (unscored) and POIs. May require additional configuration depending on regional variations."
msgstr "2 vs 2 so záverečnými rečami (bez bodov) a POI. Môže vyžadovať ďalšiu konfiguráciu podľa regionálnych odchýlok."

#: options/presets.py:197
msgid "Australian Easters Rules"
msgstr "Australian Easters pravidlá"

#: options/presets.py:199
msgid "3 vs 3 without replies, set motions, novices, intermediate bubbles, one-up-one-down. Compliant with AIDA rules."
msgstr "3 vs 3 bez záverečných rečí, stanovené tézy, nováčikovia, medzikošové bubliny, one-up-one-down. V súlade s pravidlami AIDA."

#: options/presets.py:217
msgid "2 vs 2 Impromptu"
msgstr "2 vs 2 Impromptu"

#: options/presets.py:219
msgid "2 vs 2 with replies, chosen motions, chosen sides, and novice statuses."
msgstr "2 vs 2 so záverečnými rečami, vybranými tézami, vybranými stranami a štatútmi nováčikov."

#: options/presets.py:244
msgid "3 vs 3 Prepared"
msgstr "3 vs 3 Prepared"

#: options/presets.py:246
msgid "3 vs 3 with preallocated sides, publicly displayed sides and motions, and novice statuses."
msgstr "3 vs 3 s vopred priradenými stranami, verejne zobrazenými stranami a tézami a štatútmi nováčikov."

#: options/presets.py:273
msgid "UADC Rules"
msgstr "UADC pravidlá"

#: options/presets.py:275
msgid "3 vs 3 with replies, chosen motions, and all adjudicators can receive feedback from teams."
msgstr "3 vs 3 so záverečnými rečami, vybranými tézami a všetci rozhodcovia/rozhodkyne môžu dostávať spätnú väzbu od tímov."

#: options/presets.py:312
msgid "WSDC Rules"
msgstr "WSDC pravidlá"

#: options/presets.py:314
msgid "3 vs 3 with replies, chosen motions, prop/opp side labels, and all adjudicators can receive feedback from teams."
msgstr "3 vs 3 so záverečnými rečami, vybranými tézami, označeniami strán prop/opp a všetci rozhodcovia/rozhodkyne môžu dostávať spätnú väzbu od tímov."

#: options/presets.py:352
msgid "SDL Format"
msgstr "SDL Formát"

#: options/presets.py:354
msgid "3 vs 3 with replies and cross-examinations, pre-allocated sides, private URL ballot entry, and SDL standings and draw rules."
msgstr "3 vs 3 so záverečnými rečami a krížovými výsluchmi, vopred priradenými stranami, zadávaním ballotov cez súkromnú URL a pravidlami poradia a pairingu SDL."

#: options/presets.py:596
msgid "JDL 2nd Category"
msgstr "JDL 2. kategória"

#: options/presets.py:597
msgid "2 vs 2 with replies, no cross-examinations, pre-allocated sides, private URL ballot entry, and JDL-style standings and draw rules."
msgstr "2 vs 2 so záverečnými rečami, bez krížových výsluchov, s vopred priradenými stranami, zadávaním ballotov cez súkromnú URL a pravidlami poradia a pairingu v štýle JDL."

#: options/presets.py:606
msgid "One-speaker JDL format with one team per room, no opponent, pre-allocated affirmative/negative sides, and score-based standings."
msgstr "Jednorečnícky formát JDL s jedným tímom v miestnosti, bez súpera, s vopred priradenými kladnými/zápornými stranami a poradím založeným na bodoch."

#: options/presets.py:633
msgid "Non-league tournaments (GJH Open, MDIK Open)"
msgstr "Neligové turnaje (GJH Open, MDIK Open)"

#: options/presets.py:634
msgid "SDL format without cross-examinations, used for non-league tournaments such as GJH Open and MDIK Open."
msgstr "Formát SDL bez krížových výsluchov, určený pre neligové turnaje ako GJH Open a MDIK Open."

#: options/presets.py:641
msgid "APDA Rules"
msgstr "APDA pravidlá"

#: options/presets.py:643
msgid "2 vs 2 with speech rankings and byes"
msgstr "2 vs 2 s poradím rečí a bye tímami"

#: options/presets.py:672
msgid "Public Speaking"
msgstr "Verejné rečníctvo"

#: options/presets.py:674
msgid "Arbitrary number of teams per room, one speech each, no team points"
msgstr "Ľubovolný počet tímov v miestnosti, každý jednu reč, žiadne tímové body"

#: options/presets.py:699
msgid "Public Information Options"
msgstr "Možnosti verejných informácií"

#: options/presets.py:701
msgid "For tournaments hosted online: this sets it up so that people can access the draw and other generally useful information via the tab site."
msgstr "Pre turnaje organizované online: nastavuje prístup k pairingu a ďalším užitočným informáciám cez tab stránku."

#: options/presets.py:713
msgid "Tab Release Options"
msgstr "Možnosti zverejnenia tabu"

#: options/presets.py:715
msgid "For when a tab is ready to be released. This will publicly display the results of all rounds, the team tab, the speaker tab, etc"
msgstr "Na použitie, keď je tab pripravený na zverejnenie. Verejne zobrazí výsledky všetkých kôl, tímový tab, rečnícky tab atď."

#: options/presets.py:735
msgid "Use Private URLs"
msgstr "Použiť súkromné URL"

#: options/presets.py:737
msgid "Enables participant data entry through private URLs."
msgstr "Zapína zadávanie údajov účastníkmi cez súkromné URL."

#: options/presets.py:744
msgid "Use Public Forms"
msgstr "Použiť verejné formuláre"

#: options/presets.py:746
msgid "Enables participant data entry through public forms."
msgstr "Zapína zadávanie údajov účastníkmi cez verejné formuláre."

#: options/templates/preferences_index.html:4
#: options/templates/preferences_index.html:5
msgid "Configuration"
msgstr "Konfigurácia"

#: options/templates/preferences_index.html:16
msgid "The range of scores that can awarded to speeches, replies, and teams"
msgstr "Rozsah bodov, ktoré možno udeliť rečiam, záverečným rečiam a tímom"

#: options/templates/preferences_index.html:21
msgid "How teams are paired in the draw and how adjudicators are auto-allocated"
msgstr "Ako sú tímy spárované v pairingu a ako sa rozhodcovia/rozhodkyne automaticky prideľujú"

#: options/templates/preferences_index.html:26
msgid "How many speeches in a debate, how motions are decided, and whether reply speeches are used"
msgstr "Počet rečí v debate, spôsob voľby tézy a či sa používajú záverečné reči"

#: options/templates/preferences_index.html:31
msgid "How teams and speakers are ranked in the released tabs"
msgstr "Ako sú tímy a rečníci/rečníčky zoradení v zverejnených taboch"

#: options/templates/preferences_index.html:36
msgid "How adjudicators are ranked and who can submit feedback"
msgstr "Ako sú rozhodcovia/rozhodkyne zoradení a kto môže odosielať spätnú väzbu"

#: options/templates/preferences_index.html:41
msgid "How and where are motions used"
msgstr "Ako a kde sa používajú tézy"

#: options/templates/preferences_index.html:46
msgid "How participants can register for the tournament"
msgstr "Ako sa môžu účastníci registrovať na turnaj"

#: options/templates/preferences_index.html:57
msgid "When to release a public tab is made visible and what data it shows"
msgstr "Kedy sa zverejní verejný tab a aké dáta zobrazuje"

#: options/templates/preferences_index.html:62
msgid "How ballots, feedback, and check-ins are entered, including online submission options"
msgstr "Ako sa zadávajú balloty, spätná väzba a registrácie vrátane možností online odosielania"

#: options/templates/preferences_index.html:67
msgid "What information the site displays on the publicly accessible pages"
msgstr "Aké informácie stránka zobrazuje na verejne dostupných stránkach"

#: options/templates/preferences_index.html:72
msgid "Small tweaks in what information is presented by the interface"
msgstr "Drobné úpravy informácií zobrazovaných rozhraním"

#: options/templates/preferences_index.html:77
msgid "Configures sending notifications, such as emails confirming ballot submissions or team points"
msgstr "Konfiguruje odosielanie notifikácií, napríklad e-mailov potvrdzujúcich odoslanie ballotov alebo tímové body"

#: options/templates/preferences_index.html:81
msgid "Global Settings"
msgstr "Globálne nastavenia"

#: options/templates/preferences_index.html:82
msgid "Settings which can affect all tournaments on the site"
msgstr "Nastavenia, ktoré môžu ovplyvniť všetky turnaje na stránke"

#: options/templates/preferences_index.html:94
msgid "Manually Set Current Round"
msgstr "Ručne nastaviť aktuálne kolo"

#: options/templates/preferences_index.html:95
msgid "Tabbycat will prompt you to advance the current round on each round's results page. However, if there are special circumstances that require you to override this and set the current round to something else, use this page."
msgstr "Tabbycat ťa vyzve na postup do ďalšieho kola na stránke výsledkov každého kola. Ak však nastanú špeciálne okolnosti, ktoré vyžadujú prepísanie a nastavenie iného aktuálneho kola, použi túto stránku."

#: options/templates/preferences_index.html:99
msgid "Set Round Weights for Tapered Scoring"
msgstr "Nastaviť váhy kôl pre stupňované bodovanie"

#: options/templates/preferences_index.html:100
msgid "Rounds can be weighted so that certain rounds are worth more team points."
msgstr "Kolám možno priradiť váhy, takže niektoré kolá sú hodnotné viac tímových bodov."

#: options/templates/preferences_index.html:104
msgid "Criterion Management"
msgstr "Správa kritérií"

#: options/templates/preferences_index.html:105
msgid "Create and edit ballot criteria for substantives, replies, and cross-examinations."
msgstr "Vytvoriť a upraviť kritériá ballotu pre vecné reči, záverečné reči a krížové výsluchy."

#: options/templates/preferences_index.html:109
msgid "Invite User to Create an Account"
msgstr "Pozvať používateľa na vytvorenie účtu"

#: options/templates/preferences_index.html:110
msgid "Users can be created through an invitation link sent to their email, with associated permissions."
msgstr "Používatelia môžu byť vytvorení prostredníctvom pozývacieho odkazu zaslaného na ich e-mail s pridruženými oprávneniami."

#: options/templates/preferences_index.html:115
msgid "User Roles and Permissions"
msgstr "Roly a oprávnenia používateľov"

#: options/templates/preferences_index.html:116
msgid "Create tournament roles, choose their permissions, and assign users to them."
msgstr "Vytvoriť roly turnaja, zvoliť ich oprávnenia a priradiť k nim používateľov."

#: options/templates/preferences_index.html:124
msgid "Presets"
msgstr "Prednastavenia"

#: options/templates/preferences_index.html:125
msgid "These show changes to your configuration for common situations and debate formats. You may apply these settings or modify them for your tournament directly on the preset's page."
msgstr "Tieto zobrazujú zmeny konfigurácie pre bežné situácie a debatné formáty. Tieto nastavenia môžeš použiť alebo upraviť pre svoj turnaj priamo na stránke prednastavenia."

