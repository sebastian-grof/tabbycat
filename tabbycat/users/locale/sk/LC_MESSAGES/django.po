msgstr ""
"Oprávnenia roly sa vzťahujú na každého používateľa priradeného k tejto roli."

#: users/templates/role_management.html:193
msgid "Role permissions"
msgstr "Oprávnenia roly"

#: users/templates/role_management.html:194
msgid "Grouped by admin area"
msgstr "Zoskupené podľa oblasti administrácie"

#: users/templates/role_management.html:221
msgid "Changing a role updates everyone using it."
msgstr "Zmena roly aktualizuje všetkých, ktorí ju používajú."

#: users/templates/role_management.html:224
msgid "Save Role"
msgstr "Uložiť rolu"

#: users/templates/role_management.html:239
msgid "Edit User Access"
msgstr "Upraviť prístup používateľa"

#: users/templates/role_management.html:241
msgid ""
"Use roles for normal access, then direct permissions only for exceptions."
msgstr "Použi roly na bežný prístup a priame oprávnenia iba pre výnimky."

#: users/templates/role_management.html:262
msgid "Recommended"
msgstr "Odporúčané"

#: users/templates/role_management.html:275
msgid "No roles exist yet."
msgstr "Zatiaľ neexistujú žiadne roly."

#: users/templates/role_management.html:276
msgid "Create one first."
msgstr "Najprv nejakú vytvor."

#: users/templates/role_management.html:285
msgid "Exception access"
msgstr "Výnimočný prístup"

#: users/templates/role_management.html:316
msgid "Direct permissions are added on top of selected roles."
msgstr "Priame oprávnenia sa pridávajú nad rámec vybraných rolí."

#: users/templates/role_management.html:318
msgid "Save User Access"
msgstr "Uložiť prístup používateľa"

#: users/templates/role_management.html:327
msgid "User Access Directory"
msgstr "Zoznam prístupov používateľov"

#: users/templates/role_management.html:328
msgid "Open a user to edit roles and individual permissions."
msgstr ""
"Otvor používateľa, aby si mohol upraviť roly a individuálne oprávnenia."

#: users/templates/role_management.html:335
msgid "Edit"
msgstr "Upraviť"

#: users/templates/role_management.html:341
msgid "No roles"
msgstr "Žiadne roly"

#: users/templates/role_management.html:346
