#: users/templates/account_invitation_email.html:2
msgid "Hello!"
msgstr "Ahoj!"

#: users/templates/account_invitation_email.html:6
#, python-format
msgid ""
"An administrator for the Tabbycat site hosting %(name)s has invited you to "
"create an user account on their site, at %(protocol)s://%(domain)s."
msgstr ""
"Administrátor Tabbycat stránky hostujúcej %(name)s ťa pozval vytvoriť si "
"používateľský účet na stránke %(protocol)s://%(domain)s."

#: users/templates/account_invitation_email.html:10
msgid "If you accept, please use the link below to activate your account"
msgstr "Ak pozvanie prijímaš, použi odkaz nižšie na aktiváciu účtu"

#: users/templates/account_invitation_email.html:13
msgid "If you do not accept, there is no action to be taken."
msgstr "Ak pozvanie neprijímaš, nemusíš robiť nič."

#: users/templates/account_invitation_subject.txt:2
#, python-format
msgid "Invitation to join Tabbycat site for %(name)s"
msgstr "Pozvánka na Tabbycat stránku pre %(name)s"

#: users/templates/admin/auth/delete_user_warning.html:6
msgid ""
"<strong>Warning:</strong> You shouldn't delete users from the database once "
"they've done something, because the database logs actions taken by those "
"users, and deleting the users also deletes the related logs. If you wish to "
"deactivate a user account, go back to edit the user, click on the "
"“Permissions” tab, unchecked the “Active” box, and save the user."
msgstr ""
"<strong>Upozornenie:</strong> Nemali by ste odstraňovať používateľov z "
"databázy, keď už niečo urobili, pretože databáza zaznamenáva akcie vykonané "
"týmito používateľmi a odstránenie používateľov vedie aj k odstráneniu "
"súvisiacich záznamov. Ak chcete deaktivovať používateľský účet, vráťte sa "
"späť k úpravám používateľa, kliknite na kartu „Oprávnenia“, zrušte "
"začiarknutie políčka „Aktívny“ a uložte používateľa."

