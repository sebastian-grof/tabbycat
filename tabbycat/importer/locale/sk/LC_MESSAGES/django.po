#: importer/forms.py:28
#, python-format
msgid "line %(lineno)d: %(message)s"
msgstr "riadok %(lineno)d: %(message)s"

#: importer/forms.py:55
#, python-format
msgid "This line (for %(institution)s) didn't have a code"
msgstr "Tento riadok (pre %(institution)s) neobsahoval kód"

#: importer/forms.py:60
#, python-format
msgid "This line (for %(institution)s) had too many columns"
msgstr "Tento riadok (pre %(institution)s) mal príliš veľa stĺpcov"

#: importer/forms.py:70
msgid "There were no institutions to import."
msgstr "Neboli žiadne inštitúcie na import."

#: importer/forms.py:75
#, python-format
msgid "Sorry, you can only import up to %(max_allowed)d institution at a time. (You currently have %(given)d.) Try splitting your import into smaller chunks."
msgid_plural "Sorry, you can only import up to %(max_allowed)d institutions at a time. (You currently have %(given)d.) Try splitting your import into smaller chunks."
msgstr[0] "Prepáč, naraz môžeš importovať najviac %(max_allowed)d inštitúciu. (Momentálne ich máš %(given)d.) Skús rozdeliť import na menšie časti."
msgstr[1] "Prepáč, naraz môžeš importovať najviac %(max_allowed)d inštitúcie. (Momentálne ich máš %(given)d.) Skús rozdeliť import na menšie časti."
msgstr[2] "Prepáč, naraz môžeš importovať najviac %(max_allowed)d inštitúcie. (Momentálne ich máš %(given)d.) Skús rozdeliť import na menšie časti."
msgstr[3] "Prepáč, naraz môžeš importovať najviac %(max_allowed)d inštitúcií. (Momentálne ich máš %(given)d.) Skús rozdeliť import na menšie časti."

#: importer/forms.py:107
msgid "There were no rooms to import."
msgstr "Neboli žiadne miestnosti na import."

#: importer/forms.py:112
#, python-format
msgid "Sorry, you can only import up to %(max_allowed)d room at a time. (You currently have %(given)d.) Try splitting your import into smaller chunks."
msgid_plural "Sorry, you can only import up to %(max_allowed)d rooms at a time. (You currently have %(given)d.) Try splitting your import into smaller chunks."
msgstr[0] "Prepáč, naraz môžeš importovať najviac %(max_allowed)d miestnosť. (Momentálne ich máš %(given)d.) Skús rozdeliť import na menšie časti."
msgstr[1] "Prepáč, naraz môžeš importovať najviac %(max_allowed)d miestnosti. (Momentálne ich máš %(given)d.) Skús rozdeliť import na menšie časti."
msgstr[2] "Prepáč, naraz môžeš importovať najviac %(max_allowed)d miestnosti. (Momentálne ich máš %(given)d.) Skús rozdeliť import na menšie časti."
msgstr[3] "Prepáč, naraz môžeš importovať najviac %(max_allowed)d miestností. (Momentálne ich máš %(given)d.) Skús rozdeliť import na menšie časti."

#: importer/forms.py:202
msgid "Speakers' names"
msgstr "Mená rečníkov"

#: importer/forms.py:202
msgid "Can be separated by newlines, tabs, commas or ampersands"
msgstr "Môžu byť oddelené novými riadkami, tabulátormi, čiarkami alebo znakom &"

#: importer/forms.py:203
msgid "Speakers' email addresses"
msgstr "E-mailové adresy rečníkov"

#: importer/forms.py:204
msgid "Optional, useful to include if distributing private URLs, list in same order as speakers' names"
msgstr "Voliteľné, užitočné pri distribúcii súkromných URL; uveď v rovnakom poradí ako mená rečníkov"

#: importer/forms.py:213
msgid "Name (excluding institution name)"
msgstr "Názov (bez názvu inštitúcie)"

#: importer/forms.py:214
msgid "Prefix team name with institution name?"
msgstr "Pridať pred názov tímu názov inštitúcie?"

#: importer/forms.py:217
msgid "Do not include institution name (check the \"Prefix team name with institution name?\" field instead)"
msgstr "Nezahŕňaj názov inštitúcie (namiesto toho zaškrtni pole „Pridať pred názov tímu názov inštitúcie?”)"

#: importer/forms.py:226
msgid "(Not applicable to unaffiliated teams)"
msgstr "(Nevzťahuje sa na tímy bez inštitúcie)"

#: importer/forms.py:231
msgid "One speaker's name per line"
msgstr "Jedno meno rečníka na riadok"

#: importer/forms.py:233
#, python-format
msgid "Speaker %d"
msgstr "Rečník %d"

#: importer/forms.py:235
#, python-format
msgid "speaker%d@example.edu"
msgstr "speaker%d@example.edu"

#: importer/forms.py:243
msgid "Unseeded"
msgstr "Bez nasadenia"

#: importer/forms.py:244
msgid "Free seed"
msgstr "Voľné nasadenie"

#: importer/forms.py:245
msgid "Half seed"
msgstr "Polovičné nasadenie"

#: importer/forms.py:246
msgid "Full seed"
msgstr "Plné nasadenie"

#: importer/forms.py:263
msgid "There must be at least one speaker."
msgstr "Musí byť aspoň jeden rečník."

#: importer/forms.py:272
#, python-format
msgid "%(email)s is not a valid email address."
msgstr "%(email)s nie je platná e-mailová adresa."

#: importer/forms.py:285
msgid "There are more email addresses than speakers."
msgstr "Je tu viac e-mailových adries než rečníkov."

#: importer/forms.py:327
msgid "Every team in a single tournament from the same institution must have a different name. Please correct the duplicate data."
msgstr "Každý tím v rámci jedného turnaja z rovnakej inštitúcie musí mať jedinečný názov. Oprav duplicitné údaje."

#: importer/forms.py:339
msgid "Rating"
msgstr "Hodnotenie"

#: importer/forms.py:347
#, python-format
msgid "This value must be between %(min)d and %(max)d."
msgstr "Táto hodnota musí byť medzi %(min)d a %(max)d."

#: importer/forms.py:374
msgid "Unaffiliated (no institution)"
msgstr "Bez inštitúcie"

#: importer/forms.py:386
#, python-format
msgid "%(name)s (%(code)s)"
msgstr "%(name)s (%(code)s)"

#: importer/forms.py:407
#, python-format
msgid "Sorry, you can only import up to %(max_allowed)d team at a time. (These numbers currently add to %(given)d.) Try splitting your import into smaller chunks."
msgid_plural "Sorry, you can only import up to %(max_allowed)d teams at a time. (These numbers currently add to %(given)d.) Try splitting your import into smaller chunks."
msgstr[0] "Prepáč, naraz môžeš importovať najviac %(max_allowed)d tím. (Tieto čísla momentálne dávajú dokopy %(given)d.) Skús rozdeliť import na menšie časti."
msgstr[1] "Prepáč, naraz môžeš importovať najviac %(max_allowed)d tímy. (Tieto čísla momentálne dávajú dokopy %(given)d.) Skús rozdeliť import na menšie časti."
msgstr[2] "Prepáč, naraz môžeš importovať najviac %(max_allowed)d tímu. (Tieto čísla momentálne dávajú dokopy %(given)d.) Skús rozdeliť import na menšie časti."
msgstr[3] "Prepáč, naraz môžeš importovať najviac %(max_allowed)d tímov. (Tieto čísla momentálne dávajú dokopy %(given)d.) Skús rozdeliť import na menšie časti."

#: importer/forms.py:420
#, python-format
msgid "Sorry, you can only import up to %(max_allowed)d adjudicator at a time. (These numbers currently add to %(given)d.) Try splitting your import into smaller chunks."
msgid_plural "Sorry, you can only import up to %(max_allowed)d adjudicators at a time. (These numbers currently add to %(given)d.) Try splitting your import into smaller chunks."
msgstr[0] "Prepáč, naraz môžeš importovať najviac %(max_allowed)d rozhodcu. (Tieto čísla momentálne dávajú dokopy %(given)d.) Skús rozdeliť import na menšie časti."
msgstr[1] "Prepáč, naraz môžeš importovať najviac %(max_allowed)d rozhodcov. (Tieto čísla momentálne dávajú dokopy %(given)d.) Skús rozdeliť import na menšie časti."
msgstr[2] "Prepáč, naraz môžeš importovať najviac %(max_allowed)d rozhodcu. (Tieto čísla momentálne dávajú dokopy %(given)d.) Skús rozdeliť import na menšie časti."
msgstr[3] "Prepáč, naraz môžeš importovať najviac %(max_allowed)d rozhodcov. (Tieto čísla momentálne dávajú dokopy %(given)d.) Skús rozdeliť import na menšie časti."

#: importer/forms.py:435
msgid "XML"
msgstr "XML"

#: importer/forms.py:436
msgid "Paste the Debate XML archive here."
msgstr "Vlož sem archív Debate XML."

#: importer/forms.py:437
msgid "XML file"
msgstr "XML súbor"

#: importer/forms.py:438
msgid "Or upload the exported Debate XML archive file."
msgstr "Alebo nahraj exportovaný archívny súbor Debate XML."

#: importer/forms.py:440
msgid "Adjudicator weighting"
msgstr "Váha rozhodcov/rozhodkýň"

#: importer/forms.py:443
msgid "Use archive setting (Tabbycat default if the archive does not say)"
msgstr "Použiť nastavenie archívu (predvolené Tabbycat, ak archív nešpecifikuje)"

#: importer/forms.py:444
msgid "Tabbycat default"
msgstr "Predvolené Tabbycat"

#: importer/forms.py:445
msgid "Weighted to three votes"
msgstr "Vážené na tri hlasy"

#: importer/forms.py:449
msgid "Choose how per-adjudicator ballots should be aggregated. For old SDA XML archives from weighted tournaments, choose \"Weighted to three votes\"."
msgstr "Vyber, ako sa majú agregovať balloty jednotlivých rozhodcov. Pre staré SDA XML archívy z vážených turnajov zvol „Vážené na tri hlasy\"."

#: importer/forms.py:466
msgid "Provide XML text or upload an XML file."
msgstr "Zadaj XML text alebo nahraj XML súbor."

#: importer/forms.py:471
msgid "The provided file does not contain valid Debate XML."
msgstr "Nahraný súbor neobsahuje platné Debate XML."

#: importer/templates/archive_export_index.html:4
#: importer/templates/archive_export_index.html:5
msgid "Export Tournament Archive"
msgstr "Exportovať archív turnaja"

#: importer/templates/archive_export_index.html:9
msgid "Tournaments can be exported in an <a href=\"https://en.wikipedia.org/wiki/XML\">XML format</a> for use outside Tabbycat."
msgstr "Turnaje možno exportovať vo formáte <a href=\"https://en.wikipedia.org/wiki/XML\">XML</a> na použitie mimo Tabbycat."

#: importer/templates/archive_export_index.html:17
msgid "Export all data"
msgstr "Exportovať všetky dáta"

