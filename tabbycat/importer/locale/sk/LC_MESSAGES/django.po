msgstr "Tento formulár vytvorí turnaj z údajov vo formáte Debate XML."

#: importer/templates/archive_importer.html:24
msgid "Import"
msgstr "Importovať"

#: importer/templates/archive_importer.html:25
msgid "Go back to the site home page"
msgstr "Späť na hlavnú stránku"

