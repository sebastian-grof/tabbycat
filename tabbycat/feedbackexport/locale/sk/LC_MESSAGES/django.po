"Zlyhané eventy odrozhodovaných debát zaradené na opakovanie: %(queued)s."

#: feedbackexport/views.py:205
#, python-format
msgid ""
"%(processed)s judge activity events processed; %(sent)s sent; %(failed)s "
"failed."
msgstr ""
"Spracované eventy odrozhodovaných debát: %(processed)s; odoslané: %(sent)s; "
"zlyhané: %(failed)s."

#: feedbackexport/views.py:213
msgid "Not exported"
msgstr "Neexportované"

