#: templates/feedbackexport/events.html:50
msgid "Tournament debate counts export with source identifiers. DR falls back to email, name or local ID."
msgstr "Počty debát za turnaj sa exportujú so zdrojovými identifikátormi. DR použije e-mail, meno alebo lokálne ID."

#: templates/feedbackexport/events.html:78
msgid "Tournament activity exports"
msgstr "Export odrozhodovaných debát za turnaje"

#: templates/feedbackexport/events.html:79
msgid "Select only the tournaments you want to export or re-export. Feedback is queued separately above."
msgstr "Vyber iba turnaje, ktoré chceš exportovať alebo re-exportovať. Feedbacky sa zaraďujú samostatne vyššie."

