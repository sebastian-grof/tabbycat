#: feedbackexport/templates/feedbackexport/index.html:19
#: feedbackexport/templates/feedbackexport/index.html:41
msgid "Ready"
msgstr "Pripravené"

#: feedbackexport/templates/feedbackexport/events.html:18
msgid ""
"Confirmed feedback exports with source identifiers. DR handles judge "
"matching and duplicate resolution."
msgstr ""
"Potvrdené feedbacky sa exportujú so zdrojovými identifikátormi. Párovanie "
"rozhodcov a duplicity rieši DR."

#: feedbackexport/templates/feedbackexport/events.html:29
msgid "Queue feedback"
msgstr "Zaradiť feedbacky"

