#: feedbackexport/templates/feedbackexport/events.html:202
msgid ""
"These local export events still exist, but their source tournament has been "
"removed from Tabbycat."
msgstr ""
"Tieto lokálne exportné eventy stále existujú, ale ich zdrojový turnaj bol z "
"Tabbycatu odstránený."

#: feedbackexport/templates/feedbackexport/index.html:7
#: feedbackexport/views.py:57
msgid "Overview"
msgstr "Prehľad"

#: feedbackexport/templates/feedbackexport/index.html:8
msgid ""
"A short control room for judge data exports. DR owns judge identity "
"matching; Tabbycat sends source names, emails and local IDs."
msgstr ""
"Krátky riadiaci panel exportov dát rozhodcov. Párovanie identít rieši DR; "
"Tabbycat posiela zdrojové mená, e-maily a lokálne ID."

#: feedbackexport/templates/feedbackexport/index.html:15
msgid "Feedback export"
msgstr "Export feedbackov"

#: feedbackexport/templates/feedbackexport/index.html:17
#: feedbackexport/templates/feedbackexport/index.html:37
msgid "Needs attention"
msgstr "Vyžaduje pozornosť"

#: feedbackexport/templates/feedbackexport/index.html:22
msgid ""
"Exports confirmed adjudicator feedback to DR. DR matches judges by exported "
"ID when present, then email, name and local fallback."
msgstr ""
"Exportuje potvrdený feedback rozhodcov do DR. DR páruje podľa exportovaného "
"ID, ak existuje, potom podľa e-mailu, mena a lokálneho fallbacku."

#: feedbackexport/templates/feedbackexport/index.html:24
msgid "Confirmed feedback"
msgstr "Potvrdené feedbacky"

#: feedbackexport/templates/feedbackexport/index.html:29
#: feedbackexport/templates/feedbackexport/index.html:51
msgid "Open Judge Data"
msgstr "Otvoriť dáta rozhodcov"

#: feedbackexport/templates/feedbackexport/index.html:35
msgid "Judge activity export"
msgstr "Export odrozhodovaných debát"

#: feedbackexport/templates/feedbackexport/index.html:39
msgid "Queued"
msgstr "Zaradené"

#: feedbackexport/templates/feedbackexport/index.html:44
msgid ""
"Exports adjudicated debate counts by tournament. DR matches judges by "
"exported ID when present, then email, name and local fallback."
msgstr ""
"Exportuje počty odrozhodovaných debát podľa turnaja. DR páruje podľa "
"exportovaného ID, ak existuje, potom podľa e-mailu, mena a lokálneho "
"fallbacku."

#: feedbackexport/templates/feedbackexport/index.html:46
msgid "Export events"
msgstr "Exportné eventy"

