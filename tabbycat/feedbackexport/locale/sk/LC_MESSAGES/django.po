msgstr "Odoslať čakajúce"

#: feedbackexport/templates/feedbackexport/events.html:47
msgid "Judge activity"
msgstr "Odrozhodované debaty"

#: feedbackexport/templates/feedbackexport/events.html:50
msgid ""
"Tournament debate counts export with source identifiers. DR falls back to "
"email, name or local ID."
msgstr ""
"Počty debát za turnaj sa exportujú so zdrojovými identifikátormi. DR použije"
" e-mail, meno alebo lokálne ID."

#: feedbackexport/templates/feedbackexport/events.html:78
msgid "Tournament activity exports"
msgstr "Export odrozhodovaných debát za turnaje"

#: feedbackexport/templates/feedbackexport/events.html:79
msgid ""
"Select only the tournaments you want to export or re-export. Feedback is "
"queued separately above."
msgstr ""
"Vyber iba turnaje, ktoré chceš exportovať alebo re-exportovať. Feedbacky sa "
"zaraďujú samostatne vyššie."

#: feedbackexport/templates/feedbackexport/events.html:83
msgid "Queue selected activity"
msgstr "Zaradiť vybrané debaty"

#: feedbackexport/templates/feedbackexport/events.html:84
msgid "Force re-export selected"
msgstr "Vynútiť re-export vybraných"

