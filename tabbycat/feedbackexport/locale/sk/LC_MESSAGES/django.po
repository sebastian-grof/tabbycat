#: feedbackexport/templates/feedbackexport/access.html:7
#: feedbackexport/views.py:59
msgid "Access"
msgstr "Prístupy"

#: feedbackexport/templates/feedbackexport/access.html:8
msgid "Grant global access to API Exports. Manage implies view access."
msgstr ""
"Udeľ globálny prístup k API exportom. Správa automaticky zahŕňa aj "
"zobrazenie."

#: feedbackexport/templates/feedbackexport/access.html:15
msgid "Grant access"
msgstr "Udeliť prístup"

#: feedbackexport/templates/feedbackexport/access.html:26
msgid "Save access"
msgstr "Uložiť prístup"

#: feedbackexport/templates/feedbackexport/access.html:33
msgid "Current access"
msgstr "Aktuálny prístup"

#: feedbackexport/templates/feedbackexport/access.html:53
msgid "No users have explicit API export access yet."
msgstr "Zatiaľ nikto nemá explicitný prístup k API exportom."

#: feedbackexport/templates/feedbackexport/base.html:421
msgid ""
"Live feedback export is disabled. Queueing still works, but sending requires"
" SDA_JUDGES_FEEDBACK_EXPORT_ENABLED=True."
msgstr ""
"Live export spätnej väzby je vypnutý. Zaraďovanie stále funguje, ale "
"odosielanie vyžaduje SDA_JUDGES_FEEDBACK_EXPORT_ENABLED=True."

#: feedbackexport/templates/feedbackexport/base.html:425
msgid ""
"No external feedback API endpoint is configured. Set "
"SDA_JUDGES_FEEDBACK_API_URL before processing feedback sends."
msgstr ""
"Nie je nastavený externý API endpoint pre spätnú väzbu. Pred odosielaním "
"nastav SDA_JUDGES_FEEDBACK_API_URL."

#: feedbackexport/templates/feedbackexport/base.html:429
msgid ""
"Live judge activity export is disabled. Manual queueing still works, but "
"sending requires SDA_JUDGES_ACTIVITY_EXPORT_ENABLED=True."
msgstr ""
"Live export odrozhodovaných debát je vypnutý. Manuálne zaraďovanie stále "
"funguje, ale odosielanie vyžaduje SDA_JUDGES_ACTIVITY_EXPORT_ENABLED=True."

#: feedbackexport/templates/feedbackexport/base.html:433
msgid ""
"No external judge activity API endpoint is configured. Set "
"SDA_JUDGES_ACTIVITY_API_URL before processing activity sends."
msgstr ""
"Nie je nastavený externý API endpoint pre odrozhodované debaty. Pred "
"odosielaním nastav SDA_JUDGES_ACTIVITY_API_URL."

#: feedbackexport/templates/feedbackexport/base.html:447
msgid ""
"Export structured SDA data from Tabbycat to external systems. Judge exports "
"are managed together here; feedback and activity still remain separate "
"records under the hood."
msgstr ""
"Exportuj štruktúrované SDA dáta z Tabbycatu do externých systémov. Exporty "
"rozhodcov sa spravujú spolu; feedbacky a odrozhodované debaty zostávajú "
"technicky samostatné záznamy."

#: feedbackexport/templates/feedbackexport/base.html:451
msgid "Return to Site Tools"
msgstr "Späť do Správy webu"

#: feedbackexport/templates/feedbackexport/base.html:456
msgid "API export navigation"
msgstr "Navigácia API exportov"

#: feedbackexport/templates/feedbackexport/base.html:461
msgid "Pipeline health and next actions"
msgstr "Stav exportov a ďalšie kroky"

#: feedbackexport/templates/feedbackexport/base.html:463
msgid "Feedback and adjudicated debate counts"
msgstr "Feedbacky a počty odrozhodovaných debát"

#: feedbackexport/templates/feedbackexport/base.html:465
msgid "Global permissions"
msgstr "Globálne povolenia"

#: feedbackexport/templates/feedbackexport/events.html:7
#: feedbackexport/views.py:58
msgid "Judge Data"
msgstr "Dáta rozhodcov"

#: feedbackexport/templates/feedbackexport/events.html:8
msgid ""
"One workspace for exporting judge feedback and adjudicated debate counts to "
"DR. They remain separate records, but are operated from one place."
msgstr ""
"Jedno pracovné miesto na export feedbackov rozhodcov a počtov "
"odrozhodovaných debát do DR. Záznamy zostávajú samostatné, ale ovládajú sa z"
" jedného miesta."

#: feedbackexport/templates/feedbackexport/events.html:15
#: feedbackexport/templates/feedbackexport/events.html:150
msgid "Feedback"
msgstr "Spätná väzba"

