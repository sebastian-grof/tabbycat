"%(processed)s export events processed; %(sent)s sent; %(failed)s failed."
msgstr ""
"Spracované exportné eventy: %(processed)s; odoslané: %(sent)s; zlyhané: "
"%(failed)s."

#: feedbackexport/views.py:156
msgid "Feedback export event was queued for retry."
msgstr "Exportný event feedbacku bol zaradený na opakovanie."

#: feedbackexport/views.py:164
