msgstr "žiadne tímy nedebatujú"

#: availability/views.py:115
#, python-format
msgid "%(nteams)d breaking team is debating this round"
msgid_plural "%(nteams)d breaking teams are debating this round"
msgstr[0] "%(nteams)d postupujúci tím debatuje v tomto kole"
msgstr[1] "%(nteams)d postupujúce tímy debatujú v tomto kole"
msgstr[2] "%(nteams)d postupujúce tímy debatujú v tomto kole"
msgstr[3] "%(nteams)d postupujúcich tímov debatuje v tomto kole"

#. Translators: nteams in this string can only be 0 or 1
#: availability/views.py:122
#, python-format
msgid "%(nteams)d breaking team — no debates can happen"
msgid_plural "%(nteams)d breaking teams — no debates can happen"
msgstr[0] "%(nteams)d postupujúci tím — nemôže sa konať žiadna debata"
msgstr[1] "%(nteams)d postupujúce tímy — nemôže sa konať žiadna debata"
msgstr[2] "%(nteams)d postupujúce tímy — nemôže sa konať žiadna debata"
msgstr[3] "%(nteams)d postupujúcich tímov — nemôže sa konať žiadna debata"

#. Translators: ndebating in this string is always at least 2
#: availability/views.py:130
#, python-format
msgid "%(ndebating)d breaking team is debating this round"
msgid_plural "%(ndebating)d breaking teams are debating this round"
msgstr[0] "%(ndebating)d postupujúci tím debatuje v tomto kole"
msgstr[1] "%(ndebating)d postupujúce tímy debatujú v tomto kole"
msgstr[2] "%(ndebating)d postupujúce tímy debatujú v tomto kole"
msgstr[3] "%(ndebating)d postupujúcich tímov debatuje v tomto kole"

#. Translators: This gets appended to the previous string (the one with
#. ndebating in it) if (and only if) nbypassing is greater than 0.
#. "It" refers to this round.
#: availability/views.py:138
#, python-format
msgid "; %(nbypassing)d team is bypassing it"
msgid_plural "; %(nbypassing)d teams are bypassing it"
msgstr[0] "; %(nbypassing)d tím ho obchádza"
msgstr[1] "; %(nbypassing)d tímy ho obchádzajú"
msgstr[2] "; %(nbypassing)d tímy ho obchádzajú"
msgstr[3] "; %(nbypassing)d tímov ho obchádza"

#. Translators: nadvancing in this string is always at least 2
#: availability/views.py:157
#, python-format
msgid "%(nadvancing)s advancing team is debating this round"
msgid_plural "%(nadvancing)s advancing teams are debating this round"
msgstr[0] "%(nadvancing)s postupujúci tím debatuje v tomto kole"
msgstr[1] "%(nadvancing)s postupujúce tímy debatujú v tomto kole"
msgstr[2] "%(nadvancing)s postupujúce tímy debatujú v tomto kole"
msgstr[3] "%(nadvancing)s postupujúcich tímov debatuje v tomto kole"

